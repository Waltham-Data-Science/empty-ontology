        <rdfs:label xml:lang="en">treatment: culture from cell type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000076"/>
        <obo:IAO_0000115>The purpose of a measurement, stimulus, or experiment. This describes the intended goal or objective of the scientific investigation or a specific component of it.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">purpose</rdfs:label>
    </owl:Class>
    


