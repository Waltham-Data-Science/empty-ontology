        <obo:IAO_0000115>States that the purpose of the measurement is to observe the pyloric rhythm</obo:IAO_0000115>
        <rdfs:label xml:lang="en">purpose: assessing the pyloric rhythm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000212 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000205"/>
        <obo:IAO_0000115>States that the purpose of the measurement is to observe the gastric mill rhythm</obo:IAO_0000115>
        <rdfs:label xml:lang="en">purpose: assessing the gastric mill rhythm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000213 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000213">
