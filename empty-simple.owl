        <rdfs:label xml:lang="en">purpose: assessing temporal frequency tuning</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000208">
