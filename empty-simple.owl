        <obo:IAO_0000115>States that the purpose of the stimulus is to assess ocular dominance or binocular matching</obo:IAO_0000115>
        <rdfs:label xml:lang="en">purpose: assessing ocular dominance or binocular matching</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000211">
