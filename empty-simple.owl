        <obo:IAO_0000115>The subject&apos;s right eye was opened prematurely, before natural eye opening.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">treatment: right eye premature eye opening</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000197 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000189"/>
        <obo:IAO_0000115>The subject&apos;s left eye was allowed to open naturally.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">treatment: natural left eye opening</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000189"/>
        <obo:IAO_0000115>The subject&apos;s right eye was allowed to open naturally.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">treatment: natural right eye opening</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000199 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000189"/>
        <obo:IAO_0000115>Training was provided for several hours with drifting sinusoidal gratings (provided in hours)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">treatment: grating direction-of-motion visual stimulation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000200 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000200">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000189"/>
        <obo:IAO_0000115>Specifies the pharmacological treatment assigned to a subject. This assignment dictates the experimental group, with possible values being &apos;CNO&apos; for Clozapine-N-oxide administration (2 mg/kg, i.p.) or &apos;Saline&apos; for vehicle control administration (i.p.). These treatments were administered 45 minutes before fear conditioning and before EPM testing.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">treatment: CNO or saline administration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000201 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000089"/>
        <obo:IAO_0000115>Specifies the date of birth in YYYY-MM-DD format</obo:IAO_0000115>
        <rdfs:label xml:lang="en">date of birth</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000089"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000189"/>
        <obo:IAO_0000115>The date and time when a period of food restriction begins for a subject. Unit: datetime.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">treatment: food restriction onset time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000089"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000189"/>
        <obo:IAO_0000115>The date and time when a period of food restriction ends for a subject. Unit: datetime.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">treatment: food restriction offset time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000204 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000189"/>
