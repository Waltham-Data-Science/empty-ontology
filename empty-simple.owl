        <obo:IAO_0000115>States that the purpose of the stimulus is to assess the activity of probed subjects at a particular temperature.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">purpose: assessing activity with temperature manipulation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000214 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000214">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000079"/>
        <obo:IAO_0000115>An approach to stimulation that is associated with an epoch of data but that is not already coded in stimulator metadata. This represents a specific methodology, technique, or procedural aspect applied during data collection that provides important context for interpreting the data.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">approach</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000215 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000215">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000214"/>
        <obo:IAO_0000115>Indicates that the view through the left eye was blocked during presentation of this stimulus</obo:IAO_0000115>
        <rdfs:label xml:lang="en">approach: left eye view blocked</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000216 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000214"/>
        <obo:IAO_0000115>Indicates that the view through the right eye was blocked during presentation of this stimulus</obo:IAO_0000115>
        <rdfs:label xml:lang="en">approach: right eye view blocked</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000217 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000214"/>
        <obo:IAO_0000115>The temperature of an experimental object has been commanded to be a certain value</obo:IAO_0000115>
        <rdfs:label xml:lang="en">approach: command temperature constant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000218 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000218">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000214"/>
        <obo:IAO_0000115>The temperature of an experimental object has been commanded to be a certain value at the beginning of the recording epoch</obo:IAO_0000115>
        <rdfs:label xml:lang="en">approach: command temperature start</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000219 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000219">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000214"/>
        <obo:IAO_0000115>The temperature of an experimental object has been commanded to be a certain value at the end of the recording epoch</obo:IAO_0000115>
        <rdfs:label xml:lang="en">approach: command temperature end</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000220 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000220">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000214"/>
        <obo:IAO_0000115>The measurement is performed before an optogenetic tetanus stimulus.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">approach: before optogenetic tetanus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000221 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000221">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000214"/>
        <obo:IAO_0000115>The measurement is performed after an optogenetic tetanus stimulus.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">approach: after optogenetic tetanus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000222 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000222">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000214"/>
        <obo:IAO_0000115>The measurement is performed before a long bout of artificial visual stimulation.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">approach: before artificial visual stimulation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000223 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000214"/>
        <obo:IAO_0000115>The measurement is performed after a long bout of artificial visual stimulation.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">approach: after artificial visual stimulation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000224 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000224">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000084"/>
        <obo:IAO_0000115>A categorical identifier consisting of a string of alphanumeric characters assigned by an investigator to uniquely label a subject. Unlike numerical codes, these often include descriptive prefixes related to the study or cohort.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">subject text identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000225 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000225">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000083"/>
        <obo:IAO_0000115>An enumerated identifier assigned to an experimental subject based on a sequential numbering system, used to distinguish individuals within a specific group or trial.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">subject enumerated identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000226 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000226">
        <obo:IAO_0000115>A digital document containing structured data that describes the context, parameters, and environmental conditions under which an experiment was performed. It serves to ensure the reproducibility and interpretability of the primary experimental data.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">experiment metadata file</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000227 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000227">
        <obo:IAO_0000115>A method of molecular analysis, typically in mass spectrometry, where all ions within a specified m/z range are fragmented and analyzed together. This approach provides a comprehensive and reproducible digital record of the sample without the stochastic sampling bias found in data-dependent acquisition.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">data-independent acquisition (DIA)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000228 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000228">
        <obo:IAO_0000115>A process of generating high-resolution digital representations of whole histological sections mounted on glass slides using an automated microscopy system. This enables large-scale quantitative analysis of tissue morphology and marker expression.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">slide scanner image acquisition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000229 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000229">
        <obo:IAO_0000115>A non-invasive procedure that uses ultrasound waves to generate real-time images of the heart&apos;s structure and function. In an experimental context, it is used to measure parameters such as chamber dimensions, wall thickness, and blood flow velocity.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">echocardiogram acquisition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000230 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000230">
        <obo:IAO_0000115>A digital file for which the format, encoding, or origin cannot be definitively identified by the system or investigator, necessitating further manual review or specialized software for interpretation.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">unknown electronic file type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000231 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000101"/>
        <obo:IAO_0000115>A parameter that specifies the technical settings, environmental conditions, or experimental design of a chemotaxis assay involving Caenorhabditis elegans.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans chemotaxis assay parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000232 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000231"/>
        <obo:IAO_0000115>A table containing the quantities and identities of all chemicals used as a chemoattractant (e.g., isoamyl alcohol, diacetyl) to elicit a directed movement response in C. elegans.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans chemotaxis assay parameter: chemoattractant mixture table</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000233 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000231"/>
        <obo:IAO_0000115>The volume of the chemoattractant mixture pipetted onto the agar plate in a chemotaxis assay. Unit: microliters (μL).</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans chemotaxis assay parameter: chemoattractant mixture volume</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000234 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000231"/>
        <obo:IAO_0000115>The total time elapsed from the point at which C. elegans are placed on the assay plate until the movement is arrested or the final positions are recorded. Unit: minutes.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans chemotaxis assay parameter: assay duration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000235 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000100"/>
        <obo:IAO_0000115>A quantitative or qualitative value derived from a C. elegans chemotaxis assay, typically describing the efficiency or directionality of the animals&apos; movement toward or away from a chemical source.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans chemotaxis assay measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000236 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000235"/>
        <obo:IAO_0000115>A behavioral measurement of chemotactic efficiency defined as the ratio of the straight-line displacement toward the attractant to the total path length traveled by the organism. Values range from -1 to 1.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">chemotactic ratio</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">C. elegans chemotaxis assay measurement: McCutcheon index</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000237 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000235"/>
        <obo:IAO_0000115>The average speed of a C. elegans individual or population during the duration of the chemotaxis assay. Unit: micrometers per second (µm/s).</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans chemotaxis assay measurement: mean velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000238 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000076"/>
        <obo:IAO_0000115>A specific genetic variant or line of an organism designated by the investigator, often containing unique mutations, transgenes, or genomic edits not yet categorized in a public repository.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">investigator-defined strain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000239 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000239">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000238"/>
        <obo:IAO_0000115>A specific strain of Caenorhabditis elegans, identified by its genotype or a standard nomenclature (e.g., N2, CB4856), used in experimental procedures.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans strain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000239"/>
        <obo:IAO_0000115>A C. elegans strain with the genotype daf-22 (m130). This strain was originally obtained from the Caenorhabditis Genetics Center (CGC) as strain DR476 and subsequently outcrossed three times. [Source: https://doi.org/TBD]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">BAB9001</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000239"/>
        <obo:IAO_0000115>A C. elegans klp-6 rescue strain with the genotype klp-6 (my8); Pklp-6::GFP::KLP-6 (array, IndEx 9002). [Source: https://doi.org/TBD]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">BAB9002</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000239"/>
        <obo:IAO_0000115>A C. elegans strain with the genotype cil-7 (tm5848) I, exhibiting a him phenotype. This strain was obtained from the National BioResource Project (NBRP), Japan. [Source: https://doi.org/TBD]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">TM5848</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000243 -->

