        <obo:IAO_0000115>States that the purpose of the stimulus is to assess direction of motion tuning</obo:IAO_0000115>
        <rdfs:label xml:lang="en">purpose: assessing direction of motion tuning</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000205"/>
        <obo:IAO_0000115>States that the purpose of the stimulus is to assess contrast tuning</obo:IAO_0000115>
        <rdfs:label xml:lang="en">purpose: assessing contrast tuning</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000210 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000210">
