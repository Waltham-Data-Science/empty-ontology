<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.obolibrary.org/obo/empty/empty-simple.owl#"
     xml:base="http://purl.obolibrary.org/obo/empty/empty-simple.owl"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/empty/empty-simple.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/empty/releases/2026-04-04/empty-simple.owl"/>
        <terms:description>An ontology of experimental measurements in the sciences, the purposes for which experimental measurements were made, and experimental treatments, with a focus on life sciences.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title>Experimental Measurements Purposes and Treatments ontologY</terms:title>
        <rdfs:comment>EMPTY by NDI is licensed under CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/). You are free to share (copy and redistribute the material in any medium or format) and adapt (remix, transform, and build upon the material) for any purpose, even commercially. You must give appropriate credit (by using the original ontology IRI for the whole ontology or original term IRIs for individual terms), provide a link to the license, and indicate if any changes were made. You may do so in any reasonable manner, but not in any way that suggests the licensor endorses you or your use.</rdfs:comment>
        <owl:versionInfo>Release 2025-07-10</owl:versionInfo>
        <owl:versionInfo>2026-04-04</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/IAO_0000115 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000115">
        <obo:IAO_0000115>A property representing the English language definitions of what NCI means by the concept. They may also include information about the definition&apos;s source and attribution in a form that can easily be interpreted by software.</obo:IAO_0000115>
        <obo:IAO_0000115>English language definitions of what NCI means by the concept. These are limited to 1024 characters. They may also include information about the definition&apos;s source and attribution in a form that can easily be interpreted by software.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">The official OBI definition, explaining the meaning of a class or property. Shall be Aristotelian, formalized and normalized. Can be augmented with colloquial definitions.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">The official definition, explaining the meaning of a class or property. Shall be Aristotelian, formalized and normalized. Can be augmented with colloquial definitions.</obo:IAO_0000115>
        <obo:IAO_0000115>The official definition.</obo:IAO_0000115>
        <rdfs:label>definition</rdfs:label>
        <rdfs:label xml:lang="en">definition</rdfs:label>
        <rdfs:label>textual definition</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000118 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000118">
        <obo:IAO_0000115 xml:lang="en">A label for a class or property that can be used to refer to the class or property instead of the preferred rdfs:label. Alternative labels should be used to indicate community- or context-specific labels, abbreviations, shorthand forms and the like.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">alternative label</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description">
        <rdfs:label>description</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license">
        <rdfs:label>license</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:label>title</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.geneontology.org/formats/oboInOwl#hasExactSynonym -->

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym">
        <obo:IAO_0000115>An alternative label for a class or property which has the exact same meaning than the preferred name/primary label.</obo:IAO_0000115>
        <rdfs:label>has exact synonym</rdfs:label>
        <rdfs:label xml:lang="en">has exact synonym</rdfs:label>
        <rdfs:label>has_exact_synonym</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000001">
        <obo:IAO_0000115>A quantitative or qualitative observation, recording, or assessment of a property, phenomenon, or system, obtained through standardized procedures, instruments, or methods. Measurements provide empirical data that can be used for scientific analysis, comparison, and interpretation, forming the foundation for hypothesis testing and knowledge advancement across disciplines.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000001"/>
        <obo:IAO_0000115>A type of scientific measurement that quantifies an observable action, reaction, or pattern of conduct exhibited by an organism. Behavioral measurements are typically used in biological, psychological, and ethological studies to assess an organism&apos;s response to internal states, external stimuli, or experimental manipulations. These can range from simple reflexes to complex social interactions and are obtained through methods including direct observation, video tracking, or specialized automated apparatuses.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">behavioral measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000002"/>
        <obo:IAO_0000115>A specific category of behavioral measurement obtained from the Elevated Plus Maze (EPM) apparatus, an assay widely used in neuroscience and pharmacology to study anxiety-like behavior and the effects of anxiolytic or anxiogenic compounds in laboratory animals, typically rodents. These measurements quantify various aspects of the animal&apos;s exploratory activity, spatial preference (e.g., for open vs. enclosed arms), and specific behaviors (e.g., entries, time spent in zones, freezing) within the maze, providing insights into its emotional state and response to perceived risk.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000002"/>
        <obo:IAO_0000115>A type of behavioral measurement that quantifies the reflexive motor response (startle reflex) of an organism to a sudden, intense stimulus, typically acoustic. These measurements are often used to study sensory processing, sensorimotor gating (e.g., prepulse inhibition), and emotional modulation of reflexes (e.g., fear-potentiated startle).</obo:IAO_0000115>
        <rdfs:label xml:lang="en">acoustic startle response measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000002"/>
        <obo:IAO_0000115>A type of behavioral measurement that is not a direct reading of a startle reflex, but is instead a value calculated, inferred, or derived from one or more primary Acoustic Startle Response (ASR) data points. Examples include percentage changes in ASR, ratios, or rates of change over time.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">acoustic startle response derived measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this counts the number of times the animal&apos;s body (typically defined by its center point or a significant portion) fully enters the user-defined zone designated as &apos;Open Arm (North)&apos;. The &apos;Open Arm (North)&apos; is one of the two open arms, distinguished by its assigned &apos;north&apos; orientation or designation in the experimental setup. Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm (north) - entries</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this counts the number of times the animal&apos;s body (typically defined by its center point or a significant portion) fully enters the user-defined zone designated as &apos;Open Arm (South)&apos;. The &apos;Open Arm (South)&apos; is one of the two open arms, distinguished by its assigned &apos;south&apos; orientation or designation in the experimental setup. Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm (south) - entries</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this represents the total number of times the animal&apos;s body (typically defined by its center point or a significant portion) fully enters the designated open arm zones (e.g., &apos;Open Arm (North)&apos; and &apos;Open Arm (South)&apos;). It is a common measure of exploration and anxiety. Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm total entries</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this counts the number of times the animal&apos;s head (specifically tracked by the software) enters the user-defined &apos;Open Arm (North)&apos; zone, irrespective of full body entry. This can indicate risk assessment or tentative exploration of the arm designated as &apos;north&apos;. Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm (north) - head entries</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this counts the number of times the animal&apos;s head (specifically tracked by the software) enters the user-defined &apos;Open Arm (South)&apos; zone, irrespective of full body entry, often reflecting cautious exploration of the open arm designated as &apos;south&apos;. Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm (south) - head entries</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this is the total number of times the animal&apos;s head (specifically tracked by the software) enters any of the designated open arm zones (e.g., &apos;Open Arm (North)&apos; and &apos;Open Arm (South)&apos;), considered an indicator of risk-assessment behavior. Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm total head entries</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal&apos;s body spends within the user-defined &apos;Open Arm (North)&apos; zone. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm (north) - time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal&apos;s body spends within the user-defined &apos;Open Arm (South)&apos; zone. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm (south) - time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this is the cumulative total duration the animal&apos;s body spends within any of the designated open arm zones (e.g., &apos;Open Arm (North)&apos; and &apos;Open Arm (South)&apos;). Less time is generally indicative of higher anxiety. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm total time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this represents the percentage of the total test duration that the animal spends in any of the designated open arm zones (e.g., &apos;Open Arm (North)&apos; and &apos;Open Arm (South)&apos;). Unit: %</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm total - percent time during test duration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000091"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the time elapsed from the start of the test until the animal makes its first full body entry into the user-defined &apos;Open Arm (North)&apos; zone. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm (north) - latency to first entry</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000091"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the time elapsed from the start of the test until the animal makes its first full body entry into the user-defined &apos;Open Arm (South)&apos; zone. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm (south) - latency to first entry</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000091"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the time elapsed from the start of the test until the animal makes its first full body entry into any of the designated open arm zones (e.g., &apos;Open Arm (North)&apos; or &apos;Open Arm (South)&apos;). Longer latencies often suggest higher anxiety. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm total latency to first entry</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal spends actively moving towards the user-defined &apos;Open Arm (North)&apos; zone, as detected by the tracking software. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm (north) - time moving towards</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal spends actively moving towards the user-defined &apos;Open Arm (South)&apos; zone, as detected by the tracking software. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm (south) - time moving towards</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this is the cumulative duration the animal spends actively moving towards any of the designated open arm zones (e.g., &apos;Open Arm (North)&apos; or &apos;Open Arm (South)&apos;), reflecting approach motivation. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm total time moving towards</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal exhibits freezing behavior (a state of immobility except for respiratory movements) while within the user-defined &apos;Open Arm (North)&apos; zone. Freezing is a common fear response. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm (north) - time freezing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal exhibits freezing behavior while within the user-defined &apos;Open Arm (South)&apos; zone. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm (south) - time freezing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this is the cumulative duration the animal exhibits freezing behavior while within any of the designated open arm zones (e.g., &apos;Open Arm (North)&apos; or &apos;Open Arm (South)&apos;), indicating fear or anxiety. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: open arm total time freezing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this counts the number of times the animal&apos;s body fully enters the user-defined &apos;Closed Arm (West)&apos; zone, representing the enclosed arm designated as &apos;west&apos;. Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm (west) - entries</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this counts the number of times the animal&apos;s body fully enters the user-defined &apos;Closed Arm (East)&apos; zone, representing the enclosed arm designated as &apos;east&apos;. Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm (east) - entries</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this is the total number of times the animal&apos;s body fully enters any of the designated closed arm zones (e.g., &apos;Closed Arm (West)&apos; and &apos;Closed Arm (East)&apos;). It is often used as an indicator of general locomotor activity. Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm total entries</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this counts the number of times the animal&apos;s head enters the user-defined &apos;Closed Arm (West)&apos; zone. Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm (west) - head entries</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this counts the number of times the animal&apos;s head enters the user-defined &apos;Closed Arm (East)&apos; zone. Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm (east) - head entries</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this is the total number of times the animal&apos;s head enters any of the designated closed arm zones (e.g., &apos;Closed Arm (West)&apos; and &apos;Closed Arm (East)&apos;). Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm total head entries</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal&apos;s body spends within the user-defined &apos;Closed Arm (West)&apos; zone. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm (west) - time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal&apos;s body spends within the user-defined &apos;Closed Arm (East)&apos; zone. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm (east) - time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this is the cumulative total duration the animal&apos;s body spends within any of the designated closed arm zones (e.g., &apos;Closed Arm (West)&apos; and &apos;Closed Arm (East)&apos;). Animals typically spend more time in these &apos;safer&apos; areas. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm total time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this represents the percentage of the total test duration that the animal spends in any of the designated closed arm zones (e.g., &apos;Closed Arm (West)&apos; and &apos;Closed Arm (East)&apos;). Unit: %</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm total - percent time during test duration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000091"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the time elapsed from the start of the test until the animal makes its first full body entry into the user-defined &apos;Closed Arm (West)&apos; zone. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm (west) - latency to first entry</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000036 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000091"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the time elapsed from the start of the test until the animal makes its first full body entry into the user-defined &apos;Closed Arm (East)&apos; zone. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm (east) - latency to first entry</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000037 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000091"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the time elapsed from the start of the test until the animal makes its first full body entry into any of the designated closed arm zones (e.g., &apos;Closed Arm (West)&apos; or &apos;Closed Arm (East)&apos;). Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm total latency to first entry</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal spends actively moving towards the user-defined &apos;Closed Arm (West)&apos; zone. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm (west) - time moving towards</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal spends actively moving towards the user-defined &apos;Closed Arm (East)&apos; zone. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm (east) - time moving towards</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this is the cumulative duration the animal spends actively moving towards any of the designated closed arm zones (e.g., &apos;Closed Arm (West)&apos; or &apos;Closed Arm (East)&apos;). Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm total time moving towards</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000041 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal exhibits freezing behavior while within the user-defined &apos;Closed Arm (West)&apos; zone. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm (west) - time freezing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000042 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal exhibits freezing behavior while within the user-defined &apos;Closed Arm (East)&apos; zone. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm (east) - time freezing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000043 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this is the cumulative duration the animal exhibits freezing behavior while within any of the designated closed arm zones (e.g., &apos;Closed Arm (West)&apos; or &apos;Closed Arm (East)&apos;). Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: closed arm total time freezing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this counts the number of times the animal&apos;s body fully enters the user-defined &apos;Center&apos; zone of the maze, typically from one of the arms. The center zone is the area where all four arms meet. Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: center - entries</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000045 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this counts the number of times the animal&apos;s head enters the user-defined &apos;Center&apos; zone of the maze. Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: center - head entries</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal&apos;s body spends within the user-defined &apos;Center&apos; zone. Time in the center can indicate decision-making or risk assessment. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: center - time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this represents the percentage of the total test duration that the animal spends in the user-defined &apos;Center&apos; zone of the maze. Unit: %</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: center - percent time during test duration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000048 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000091"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the time elapsed from the start of the test until the animal makes its first full body entry into the user-defined &apos;Center&apos; zone. If the animal starts in the center, this value may be zero or not applicable. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: center - latency to first entry</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal spends actively moving towards the user-defined &apos;Center&apos; zone of the maze (e.g., from an arm). Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: center - time moving towards</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000050 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this measures the total duration the animal exhibits freezing behavior while within the user-defined &apos;Center&apos; zone of the maze. Freezing in this relatively exposed area can indicate high anxiety. Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: center - time freezing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000092"/>
        <obo:IAO_0000115>For an Elevated Plus Maze experiment, this is a unique code or descriptive name assigned to identify a specific experimental session, trial, or a particular set of recorded data. It helps in organizing and referencing data from distinct observations.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: test identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000084"/>
        <obo:IAO_0000115>For an experiment, this is a unique code or label assigned to an individual animal subject. This allows for tracking and associating behavioral data with specific animals, along with their characteristics like strain, sex, or age.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">subject local identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000004"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000162"/>
        <obo:IAO_0000115>In the Fear-potentiated startle paradigm, this is the amplitude of the acoustic startle response (ASR) measured in response to a startle-eliciting stimulus (e.g., 95-dB white noise burst) prior to any fear conditioning procedures, typically assessed during habituation or pre-conditioning phase. This measurement serves as a reference point for later comparisons with post-conditioning startle responses. Unit: arbitrary units or standardized score.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">fear-potentiated startle: baseline acoustic startle response amplitude</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000054 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000083"/>
        <obo:IAO_0000115>A relative experimental session timeline; major stimulation events are, by default, considered numerically from 1 to N.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">session timeline</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000055 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000084"/>
        <obo:IAO_0000115>Postnatal day is a specific unit to measure the age of an organism that is born live (viviparous animals), starting with the day of birth (postnatal day 0). Often abbreviated in written documents with a capital P (as in P0, P10, etc).</obo:IAO_0000115>
        <rdfs:label xml:lang="en">postnatal day</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000056 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000001"/>
        <obo:IAO_0000115>A voltage offset measured at the end of a voltage record, in V</obo:IAO_0000115>
        <rdfs:label xml:lang="en">microelectrode voltage offset</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000057 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000084"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000093"/>
        <obo:IAO_0000115>A descriptive string identifying the specific type or condition of a trial in a Fear-Potentiated Startle (FPS) experiment. Examples from the manuscript include &apos;pre-shock&apos; (baseline startle), &apos;post-shock&apos; (startle in conditioning context after shocks), &apos;noise-only&apos; (startle to acoustic stimulus alone during recall tests), or &apos;light+noise&apos; (startle to acoustic stimulus in presence of conditioned cue during recall tests). The raw data might contain labels like &apos;Startle 95 dB Trial&apos;.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">fear-potentiated startle: trial type identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000058 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000093"/>
        <obo:IAO_0000115>Identifier for the specific Plexiglas enclosure or sound-attenuating chamber within the Fear-Potentiated Startle (FPS) apparatus (e.g., San Diego Instruments SR-Lab) in which a subject was tested for a given trial. Unit: count or identifier string</obo:IAO_0000115>
        <rdfs:label xml:lang="en">fear-potentiated startle: apparatus chamber identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000059 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000084"/>
        <obo:IAO_0000115>A numerical code that assigns a subject to a specific experimental group within the study design. For example, this could numerically represent treatment groups such as &apos;saline&apos; or &apos;CNO&apos; as described in the manuscript, or other study-specific groupings.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">experimental group code</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000093"/>
        <obo:IAO_0000115>The total number of data points (samples) recorded and analyzed for a single acoustic startle response, typically within a defined time window following stimulus onset (e.g., a 200-ms window as mentioned in the manuscript). Unit: count</obo:IAO_0000115>
        <rdfs:label xml:lang="en">acoustic startle response: number of samples</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000093"/>
        <obo:IAO_0000115>The rate at which the analog startle response signal was digitized during data acquisition. Unit: Hertz (Hz)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">acoustic startle response: sampling rate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000004"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000162"/>
        <obo:IAO_0000115>The amplitude of the digitized acoustic startle response signal at the very beginning (onset) of the defined analysis window (e.g., a 200-ms window) used to quantify the reflex. Unit: millivolts (mV) or arbitrary units based on transducer calibration.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">acoustic startle response: startle window onset amplitude</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000063 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000004"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000162"/>
        <obo:IAO_0000115>The peak amplitude of the acoustic startle response (e.g., &apos;jump amplitude&apos;) detected within the defined analysis window (e.g., 200-ms window) for a given trial. Unit: millivolts (mV) or arbitrary units.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">acoustic startle response: maximum amplitude</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000064 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000004"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000091"/>
        <obo:IAO_0000115>The latency from the onset of the startle-eliciting stimulus (or the beginning of the analysis window) to the occurrence of the maximum (peak) amplitude of the acoustic startle response. Unit: milliseconds (ms)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">acoustic startle response: time to maximum amplitude</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000065 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000065">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000004"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000162"/>
        <obo:IAO_0000115>The average amplitude of the digitized acoustic startle response signal calculated across the entire duration of the defined analysis window (e.g., 200-ms window). Unit: millivolts (mV) or arbitrary units.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">acoustic startle response: average amplitude</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000066 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000089"/>
        <obo:IAO_0000115>The specific date and time indicating when an individual experimental trial was conducted or its data recorded.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">experiment trial execution timestamp</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000067 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000084"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000093"/>
        <obo:IAO_0000115>A string identifier indicating the specific experimental phase, session, or test condition of the Fear-Potentiated Startle (FPS) paradigm to which the data belongs. Examples include &apos;chamber and startle habituation&apos;, &apos;baseline pre-shock test&apos;, &apos;fear conditioning&apos;, &apos;cued fear recall in context B&apos;, &apos;contextual fear recall in context A&apos;, or specific extinction test sessions. [Source: https://doi.org/10.1016/j.celrep.2025.115768]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">fear-potentiated startle: experimental phase or test name</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000068 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000092"/>
        <obo:IAO_0000115>In the Elevated Plus Maze task, this is the time of the total test duration in seconds&apos;). Unit: seconds</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze: test duration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000069 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000085"/>
        <obo:IAO_0000115>A boolean flag indicating whether the data from a specific subject or experimental replicate should be excluded from subsequent analysis due to predefined quality control issues or experimental failure.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">data exclusion flag</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000070 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000071"/>
        <obo:IAO_0000115>A type of neuron located in the dorsolateral bed nucleus of the stria terminalis (BNSTDL) that produces post-inhibitory spikes in response to preceding negative current steps, which is related to the action of the low-threshold Ca2+ current. These neurons also display strong voltage sags under hyperpolarizing current pulses, indicating a high level of the hyperpolarization-activated cation current (Ih). [Source: https://doi.org/10.1016/j.celrep.2025.115768]</obo:IAO_0000115>
        <obo:IAO_0000118>BNSTNeuronTypeII</obo:IAO_0000118>
        <rdfs:label xml:lang="en">type II BNST neuron</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000071 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000071">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000076"/>
        <obo:IAO_0000115>A cell type proposed by an investigator on the basis of electrophysiological or anatomical criteria.</obo:IAO_0000115>
        <obo:IAO_0000118>investigatorDefinedCellType</obo:IAO_0000118>
        <rdfs:label xml:lang="en">investigator-defined cell type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000072 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000071"/>
        <obo:IAO_0000115>A type of neuron located in the dorsolateral bed nucleus of the stria terminalis (BNSTDL) that fires regularly, displays moderate spike frequency adaptation, and exhibits a voltage sag indicating the presence of the hyperpolarization-activated cation current (Ih). [Source: https://doi.org/10.1016/j.celrep.2025.115768]</obo:IAO_0000115>
        <obo:IAO_0000118>BNSTNeuronTypeI</obo:IAO_0000118>
        <rdfs:label xml:lang="en">type I BNST neuron</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000073 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000071"/>
        <obo:IAO_0000115>A type of neuron located in the dorsolateral bed nucleus of the stria terminalis (BNSTDL) characterized by a high rheobase, absence of voltage sag under negative current steps, prominent inward rectification due to the activation of the inward rectifying K+ current (IKIR) at membrane potentials more negative than approximately -50 mV, and firing onset after a characteristic slow voltage ramp mediated by the K+ delayed current (ID). [Source: https://doi.org/10.1016/j.celrep.2025.115768]</obo:IAO_0000115>
        <obo:IAO_0000118>BNSTNeuronTypeIII</obo:IAO_0000118>
        <rdfs:label xml:lang="en">type III BNST neuron</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000074 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000086"/>
        <obo:IAO_0000115>The specific anatomical region where tetanic light stimulation (TLS) is applied in optogenetic experiments to evoke neuronal activity. The value should be defined by the ONTOLOGY_NAME:ONTOLOGY_NODE (e.g. &apos;UBERON:0000123&apos;).</obo:IAO_0000115>
        <obo:IAO_0000118>optogeneticTetanusStimulationTargetLocation</obo:IAO_0000118>
        <rdfs:label xml:lang="en">optogenetic tetanus stimulation target location</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000075 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000083"/>
        <obo:IAO_0000115>The index of an individual experimental trial within a set.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">experimental trial number</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000076 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000076">
        <obo:IAO_0000115>A term that describes, characterizes, or quantifies an aspect of an experimental entity, process, or system.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">descriptor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000077 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000077">
        <obo:IAO_0000115>An intentional action, intervention, or condition applied during an experiment to observe its effect on a subject or system.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">manipulation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000077"/>
        <obo:IAO_0000115>A manipulation that is applied or relevant to a specific, defined segment of time (an epoch) within an experiment, often coinciding with data recording.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">epoch-related manipulation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000079 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000079">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000077"/>
        <obo:IAO_0000115>A manipulation applied to an experimental subject that alters its overall state, which is not necessarily linked to a specific data collection epoch. This often includes long-term interventions like pharmacological treatments or surgical procedures.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">subject-related manipulation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000080 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000080">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000076"/>
        <obo:IAO_0000115>A variable, characteristic, or measurable factor that helps define a particular system, experiment, or process. Parameters are often controlled or measured to understand their effect on the outcome.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000081 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000076"/>
        <obo:IAO_0000115>One or more characters used to identify, name, or characterize the nature, properties, or contents of a thing.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000081"/>
        <obo:IAO_0000115>A standardized number used to uniquely identify information in computer systems, ensuring that no two identifiers are the same across different systems or contexts.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">UUID</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">universally unique identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000083 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000081"/>
        <obo:IAO_0000115>An identifier assigned sequentially from a numbered list, typically as an integer (e.g., 1, 2, 3), to distinguish between individual items.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">enumerated identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000084 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000081"/>
        <obo:IAO_0000115>An identifier that assigns an item to a specific, predefined category or Class, often represented by a string or label.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">categorical identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000085 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000081"/>
        <obo:IAO_0000115>A binary variable, typically boolean (true/false), used to indicate the presence or absence of a specific condition, state, or attribute.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">flag</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000086 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000086">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000081"/>
        <obo:IAO_0000115>An identifier that specifies a term within a formal ontology, which should be represented as a combination of the ontology&apos;s name and the term&apos;s unique ID (e.g., ontologyName:ontologyID).</obo:IAO_0000115>
        <rdfs:label xml:lang="en">ontology node</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000087 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000087">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000082"/>
        <obo:IAO_0000115>A unique identifier assigned to a document within the Neuroscience Data Interface (NDI) framework, used to link experimental data to its corresponding metadata and parameters.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">NDI document identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000088 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000088">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000001"/>
        <obo:IAO_0000115>A measurement that quantifies a property related to time, such as a specific moment, an interval, or a rate of occurrence.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">time-related measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000089 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000089">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000088"/>
        <obo:IAO_0000115>A sequence of characters or encoded information identifying when a certain event occurred, usually giving the date and time of day, sometimes to a small fraction of a second.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">timestamp</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000090 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000088"/>
        <obo:IAO_0000115>A measurement of the total amount of time that an event or process continues from its start to its end.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">duration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000091 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000091">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000088"/>
        <obo:IAO_0000115>A measurement representing a single, specific moment in time at which an event occurs or an observation is made. Typically reported in seconds.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">timepoint</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000092 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000080"/>
        <obo:IAO_0000115>A parameter that specifies the settings or technical details of an Elevated Plus Maze experiment.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">elevated plus maze parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000093 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000080"/>
        <obo:IAO_0000115>A parameter that specifies the settings or technical details of a Fear-potentiated startle experiment.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">fear-potentiated startle parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000094 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000001"/>
        <obo:IAO_0000115>The ambient room temperature recorded during an experiment. Unit: degrees Celsius.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">ambient temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000001"/>
        <obo:IAO_0000115>The ambient room humidity recorded during an experiment. Unit: percentage (%).</obo:IAO_0000115>
        <rdfs:label xml:lang="en">ambient humidity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000096 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000096">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000087"/>
        <obo:IAO_0000115>A unique alphanumeric identifier assigned to an NDI subject document.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">subject document identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000097 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000097">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000080"/>
        <obo:IAO_0000115>A specific parameter related to the experimental setup or conditions of an assay involving the nematode Caenorhabditis elegans.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans assay parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000098 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000080"/>
        <obo:IAO_0000115>A specific parameter describing the properties or conditions of bacteria in an experiment.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000099 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000099">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000084"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000097"/>
        <obo:IAO_0000115>A string identifier indicating the specific phase of a C. elegans experiment (e.g. &apos;cultivation&apos; or &apos;behavior&apos;).</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans assay phase</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000002"/>
        <obo:IAO_0000115>A quantitative or qualitative value obtained from a C. elegans behavioral assay, used to describe an aspect of the animal&apos;s movement, position, or interaction with its environment.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000101 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000101">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000097"/>
        <obo:IAO_0000115>A controlled or measured variable specifically related to the design and execution of a C. elegans behavioral assay.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000102 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000097"/>
        <obo:IAO_0000115>A parameter related to the conditions under which C. elegans were grown and maintained before being used in an experiment, such as the food source or temperature.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans cultivation parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000083"/>
        <obo:IAO_0000115>A unique numerical identifier for a distinct experimental session.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">experiment session identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000087"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000098"/>
        <obo:IAO_0000115>Unique alphanumeric identifier that links to an OpenMINDs document describing the strain of bacteria used in an experiment.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial strain document identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000098"/>
        <obo:IAO_0000115>The intended or nominal optical density at 600 nm (OD 600) to which the bacterial solution was diluted for creating bacterial patches on agar plates. Unit: dimensionless.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial OD600 (target) at seeding</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000089"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000161"/>
        <obo:IAO_0000115>The date and time when a liquid culture of bacteria was seeded (pipetted) onto an agar plate. Unit: datetime.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial plate seeding timestamp</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000107 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000089"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000161"/>
        <obo:IAO_0000115>The date and time when an agar plate seeded with bacteria was transferred to cold storage (at approximately 4 degrees Celsius) to arrest or slow bacterial growth, if part of the protocol. Unit: datetime.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial plate cold storage timestamp</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000108 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000089"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000161"/>
        <obo:IAO_0000115>The date and time when an agar plate seeded with bacteria was moved from cold storage to room temperature (at approximately 25 degrees Celsius) to continue bacterial growth, if part of the protocol. Unit: datetime.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial plate room temperature timestamp</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000109 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000084"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000097"/>
        <obo:IAO_0000115>The developmental stage (e.g. &apos;L4&apos; or &apos;1DOA&apos;) at the time in which C. elegans were picked to the agar plate. Unit: datetime.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans developmental stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000110 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000161"/>
        <obo:IAO_0000115>The measured optical density at 600 nm (OD600) of a reference liquid culture of bacteria. Unit: dimensionless.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial OD600 measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000111 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000161"/>
        <obo:IAO_0000115>The concentration of viable bacterial cells quantified as Colony Forming Units per milliliter (CFU/mL), estimated for the reference liquid culture of bacteria. Unit: CFU/mL.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial colony forming units (CFU) measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000083"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000098"/>
        <obo:IAO_0000115>A unique numerical identifier assigned to the physical plate (e.g., NGM agar plate) on which bacterial patch(s) were seeded.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial plate identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000087"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000098"/>
        <obo:IAO_0000115>A unique alphanumeric identifier assigned to an NDI ontologyTableRow document that contains the set of parameters and conditions for a specific agar plate containing bacterial patch(s).</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial plate document identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000114 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000089"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000097"/>
        <obo:IAO_0000115>The date and time when C. elegans were picked to an agar plate. Unit: datetime.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans picked timestamp</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000084"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000101"/>
        <obo:IAO_0000115>A string label referring to the layout of food patches (i.e., &apos;SingleDensityMultiPatch&apos;, &apos;MultiDensityMultiPatch&apos;,&apos;LargeSinglePatch&apos;,&apos;SmallSinglePatch&apos;) for experiments in Haley et al. (2025). [Source: https://doi.org/10.7554/eLife.103191.2.sa4]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay label</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000116 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000084"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000098"/>
        <obo:IAO_0000115>A string label used to categorize or identify the nominal OD600 condition of bacterial patches in an experiment (e.g., &apos;1.0&apos;, &apos;0.5&apos;, &apos;10.0&apos;) corresponding to the relative density conditions for experiments in Haley et al. (2025). [Source: https://doi.org/10.7554/eLife.103191.2.sa4]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial OD600 label</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000117 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000084"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000098"/>
        <obo:IAO_0000115>A string label (e.g. &apos;1&apos;,&apos;12&apos;,&apos;48&apos;) indicating the approximate duration of bacterial growth at room temperature (in hours) for experiments in Haley et al. (2025). [Source: https://doi.org/10.7554/eLife.103191.2.sa4]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial plate growth duration label</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000085"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000098"/>
        <obo:IAO_0000115>A boolean flag indicating whether peptone was included in the agar assay plates. Peptone presence supports bacterial growth. True: peptone included.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial plate peptone inclusion flag</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000090"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000161"/>
        <obo:IAO_0000115>The total duration for which bacterial patch(s) on agar plates were allowed to grow at room temperature starting at the time seeded and ending at the beginning of the assay. Unit: hours.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacteria growth duration after seeding</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000120 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000098"/>
        <obo:IAO_0000115>The volume of bacterial solution pipetted to create an individual patch on an agar plate. Note: Volumes under 1 µL are approximate due to the difficulty of pipetting liquids at this scale. Unit: microliters (µL).</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch volume</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000098"/>
        <obo:IAO_0000115>The intended center-to-center distance between adjacent bacterial food patches when arranged in a grid on an agar plate. Unit: millimeters (mm).</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch spacing (target)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000101"/>
        <obo:IAO_0000115>The diameter of the experimental plate or arena used to corral animals in a C. elegans behavioral assay. A typical 9 cm agar plate will by 90 mm. Unit: millimeters (mm).</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay: plate or arena diameter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000083"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000098"/>
        <obo:IAO_0000115>A unique numerical identifier assigned to a patch of bacteria growing on an agar assay plate.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000124 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000161"/>
        <obo:IAO_0000115>The X pixel coordinate representing the geometric center of an individual detected bacterial food patch within an assay arena. Unit: pixels.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch center: X coordinate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000161"/>
        <obo:IAO_0000115>The Y pixel coordinate representing the geometric center of an individual detected bacterial food patch within an assay arena. Unit: pixels.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch center: Y coordinate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000126 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000126">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000161"/>
        <obo:IAO_0000115>The radius of an individual detected bacterial patch on an agar plate, assuming patches are circular or near-circular. Unit: pixels.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch radius</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000161"/>
        <obo:IAO_0000115>A quantitative measure assessing how closely the shape of an individual detected bacterial patch conforms to a perfect circle. 1 is a perfect circle. [Source: https://www.mathworks.com/help/images/ref/regionprops.html]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch circularity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000128 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000128">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000083"/>
        <obo:IAO_0000115>A unique numerical identifier assigned to a subject in an experiment.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">subject identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000129 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000100"/>
        <obo:IAO_0000115>A video recording capturing the behavior of C. elegans during an experimental assay.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay: video recording</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000130 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000130">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000101"/>
        <obo:IAO_0000115>A binary image (logical matrix) where pixels within the experimental arena for C. elegans are marked (true) and pixels outside are unmarked (false). This mask defines the region of interest for worm tracking and behavioral analysis.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay: arena mask</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000131 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000131">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000098"/>
        <obo:IAO_0000115>A binary image mask (logical matrix) representing the union of all individually detected bacterial patch areas on an assay plate. This mask defines all food-containing regions.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch mask</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000132 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000098"/>
        <obo:IAO_0000115>An image or map where each pixel&apos;s value is the identifier of the bacterial patch closest to that pixel&apos;s location.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch closest identifier map</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000133 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000161"/>
        <obo:IAO_0000115>An image of fluorescently labeled bacterial patches that has been processed to correct for uneven illumination. This is achieved by dividing the raw fluorescence image by a corresponding, smoothed background image (typically of an empty agar plate), thereby removing illumination-dependent spatial variance in the signal intensity. Unit: dimensionless.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch fluorescence image (normalized)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000134 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000087"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000098"/>
        <obo:IAO_0000115>A unique alphanumeric identifier assigned to an NDI ontologyTableRow document that details the specific parameters of a bacterial food patch such as its location, size, and density.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch document identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000135 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000135">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000076"/>
        <obo:IAO_0000115>A distinct anatomical region of the C. elegans worm, such as the head, midpoint, or tail, which can be tracked to quantify behavior.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans body part</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000136 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000136">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000135"/>
        <obo:IAO_0000115>The anterior-most part of the C. elegans body.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans head</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000137 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000137">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000135"/>
        <obo:IAO_0000115>The center point of the C. elegans body.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans midpoint</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000138 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000138">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000135"/>
        <obo:IAO_0000115>The posterior-most part of the C. elegans body.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans tail</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000139 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000139">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000083"/>
        <obo:IAO_0000115>A unique numerical identifier assigned to a specific encounter event for a given animal. This distinguishes individual encounters for detailed analysis.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay: encounter identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000140 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000091"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000100"/>
        <obo:IAO_0000115>The time, in seconds, corresponding to the frame at which the C. elegans worm enters a bacterial food patch. This is the precise start time of an encounter.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay: encounter onset time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000091"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000100"/>
        <obo:IAO_0000115>The time, in seconds, corresponding to the frame at which the C. elegans worm exits a bacterial food patch. This is the precise end time of an encounter.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay: encounter offset time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000142 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000100"/>
        <obo:IAO_0000115>The rate of change in the C. elegans worm&apos;s velocity, measured as the slope of the velocity curve during a defined time window surrounding its encounter with a bacterial patch. A negative value indicates a slowdown upon encounter. Unit: µm/s².</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay: deceleration upon encounter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000143 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000100"/>
        <obo:IAO_0000115>The minimum instantaneous velocity recorded for the C. elegans worm while it is located on a bacterial food patch during an encounter. Unit: µm/s.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay: minimum velocity during encounter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000144 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000144">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000100"/>
        <obo:IAO_0000115>The peak instantaneous velocity of the C. elegans worm observed within 10 seconds before its entry into a bacterial food patch. Unit: µm/s.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay: peak velocity before encounter onset</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000145 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000100"/>
        <obo:IAO_0000115>The minimum instantaneous velocity of the C. elegans worm observed within 10 seconds after its entry into a bacterial food patch. Unit: µm/s.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay: minimum velocity after encounter offset</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000146 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000146">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000100"/>
        <obo:IAO_0000115>The posterior probability, derived from a Gaussian Mixture Model (GMM) Classification, that a given patch encounter represents an &apos;exploitation&apos; event (i.e., the worm has accepted the patch and is consuming bacteria). This value ranges from 0 to 1. [Source: https://doi.org/10.7554/eLife.103191.2.sa4]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay: posterior probability of exploitation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000147 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000100"/>
        <obo:IAO_0000115>The posterior probability, derived from a semi-supervised Quadratic Discriminant Analysis (QDA), that a given patch encounter was &apos;sensed&apos; by the C. elegans worm (i.e., the animal detected the presence of bacteria, typically indicated by a slowdown). This value ranges from 0 to 1. [Source: https://doi.org/10.7554/eLife.103191.2.sa4]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay: posterior probability of sensing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000148 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000101"/>
        <obo:IAO_0000115>A normalized, quantitative measure of the bacterial density of a specific bacterial food patch that a C. elegans worm encounters during an assay. [Source: https://doi.org/10.7554/eLife.103191.2.sa4]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay: relative density of encountered bacteria</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000149 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000101"/>
        <obo:IAO_0000115>A normalized, quantitative measure of the bacterial density on the agar plates where C. elegans were cultivated prior to the behavioral assay. [Source: https://doi.org/10.7554/eLife.103191.2.sa4]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">C. elegans behavioral assay: relative density of cultivation bacteria</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000161"/>
        <obo:IAO_0000115>A measurement in a bacterial fluorescence assay used to estimate the relative density of bacterial patches.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial fluorescence assay measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000151 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000151">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000089"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000161"/>
        <obo:IAO_0000115>The date and time when an agar plate was poured. Unit: datetime.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">agar plate pouring timestamp</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000089"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000161"/>
        <obo:IAO_0000115>The date and time when an agar plate was transferred to cold storage (at approximately 4 degrees Celsius) to retain moisture for long-term storage. Unit: datetime.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">agar plate cold storage timestamp</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000153 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000083"/>
        <obo:IAO_0000115>A unique numerical identifier for a microscopy image.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">microscopy image identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000154 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000080"/>
        <obo:IAO_0000115>The duration the microscope&apos;s camera or sensor is exposed to light. Unit: milliseconds.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">microscopy image exposure time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000155 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000155">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000150"/>
        <obo:IAO_0000115>The maximum pixel intensity detected along the radial profile of a fluorescent bacterial patch, typically found at the patch edge where bacteria are actively proliferating. [Source: https://doi.org/10.7554/eLife.103191.3]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch border peak fluorescence intensity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000156 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000150"/>
        <obo:IAO_0000115>The pixel intensity measured at the detected border of a fluorescent bacterial patch. [Source: https://doi.org/10.7554/eLife.103191.3]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch border edge fluorescence intensity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000157 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000157">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000150"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000162"/>
        <obo:IAO_0000115>A measure of bacterial density defined as the difference between the peak pixel intensity and the border pixel intensity of a fluorescent bacterial patch. [Source: https://doi.org/10.7554/eLife.103191.3]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch border fluorescence amplitude</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000150"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000162"/>
        <obo:IAO_0000115>The average pixel intensity computed across every pixel of a fluorescent bacterial patch. [Source: https://doi.org/10.7554/eLife.103191.3]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch mean fluorescence amplitude</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000159 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000150"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000162"/>
        <obo:IAO_0000115>The average pixel intensity of the middle 50% of a fluorescent bacterial patch. [Source: https://doi.org/10.7554/eLife.103191.3]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch center fluorescence amplitude</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMPTY_0000160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMPTY_0000160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMPTY_0000150"/>
        <obo:IAO_0000115>The ratio of the patch border amplitude to the patch center amplitude, used as a measure of bacterial distribution within the patch. [Source: https://doi.org/10.7554/eLife.103191.3]</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bacterial patch border-to-center fluorescence ratio</rdfs:label>
    </owl:Class>
    


