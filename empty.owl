            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_acid_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16765"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An  ammonium ion that is the conjugate acid of tryptamine arising from protonation of the primary amino group; major species at pH 7.3.</obo:IAO_0000115>
        <rdfs:label>tryptaminium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_57977 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_57977">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28965"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_59252"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_77746"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
