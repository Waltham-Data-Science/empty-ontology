                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000006"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000666"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002144"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>pancreatic islet capillary endothelial cell</rdfs:label>
    </owl:Class>
    


