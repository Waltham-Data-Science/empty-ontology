        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35381"/>
        <obo:IAO_0000115>Any six-carbon monosaccharide which in its linear form contains either an aldehyde group at position 1 (aldohexose) or a ketone group at position 2 (ketohexose).</obo:IAO_0000115>
        <rdfs:label>hexose</rdfs:label>
    </owl:Class>
    


