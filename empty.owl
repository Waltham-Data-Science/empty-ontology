        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_39141"/>
        <obo:IAO_0000115>A Bronsted acid derived from one or more inorganic compounds. Inorganic acids (also known as mineral acids) form hydrons and conjugate base ions when dissolved in water.</obo:IAO_0000115>
        <rdfs:label>inorganic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_138366 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_138366">
