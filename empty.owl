                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16990"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A dicarboxylic acid dianion obtained by deprotonation of the two carboxy groups of bilirubin; major species at pH 7.3.</obo:IAO_0000115>
        <rdfs:label>bilirubin(2-)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_58942 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_58942">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64769"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_acid_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33708"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An amino-acid residue protonated on nitrogen.</obo:IAO_0000115>
        <rdfs:label>cationic amino-acid residue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_58951 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_58951">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28868"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_base_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26666"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any fatty acid anion obtained by removal of a proton from the carboxy group of a short-chain fatty acid (chain length of less than C6).</obo:IAO_0000115>
        <rdfs:label>short-chain fatty acid anion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_58953 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_58953">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28868"/>
        <obo:IAO_0000115>Any fatty acid anion in which there is no C-C unsaturation.</obo:IAO_0000115>
        <rdfs:label>saturated fatty acid anion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_58954 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_58954">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_58953"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_base_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_39418"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any saturated fatty acid anion lacking a carbon side-chain.</obo:IAO_0000115>
        <rdfs:label>straight-chain saturated fatty acid anion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_58958 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_58958">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25696"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33482"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#has_functional_parent"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16189"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_base_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25704"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An organic anion of general formula RS(=O)2O(-) where R is an organyl group.</obo:IAO_0000115>
        <rdfs:label>organosulfate oxoanion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_59202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_59202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35366"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_acid_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_59203"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any fatty acid whose skeletal carbon atoms form an unbranched open chain.</obo:IAO_0000115>
        <rdfs:label>straight-chain fatty acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_59203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_59203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28868"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_base_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_59202"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A fatty acid anion formed by deprotonation of the carboxylic acid functional group of a straight-chain fatty acid.</obo:IAO_0000115>
        <rdfs:label>straight-chain fatty acid anion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_59252 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_59252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25696"/>
        <obo:IAO_0000115>An organic anion arising from deprotonation of a acyclic tetrapyrrole compound.</obo:IAO_0000115>
        <rdfs:label>linear tetrapyrrole anion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_59740 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_59740">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33893"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_39144"/>
        <obo:IAO_0000115>A reagent that forms a bond to its reaction partner (the electrophile) by donating both bonding electrons.</obo:IAO_0000115>
        <rdfs:label>nucleophilic reagent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_59888 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_59888">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35238"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_tautomer_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16865"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Zwitterionic form of gamma-aminobutyric acid having an anionic carboxy group and a protonated amino group.</obo:IAO_0000115>
        <rdfs:label>gamma-aminobutyric acid zwitterion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_59999 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_59999">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A chemical substance is a portion of matter of constant composition, composed of molecular entities of the same type or of different types.</obo:IAO_0000115>
        <rdfs:label>chemical substance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_60004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_60004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_59999"/>
        <obo:IAO_0000115>A mixture is a chemical substance composed of multiple molecules, at least two of which are of a different kind.</obo:IAO_0000115>
        <rdfs:label>mixture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_60027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_60027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_60004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33839"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A polymer is a mixture, which is composed of macromolecules of different kinds and which may be differentiated by composition, length, degree of branching etc..</obo:IAO_0000115>
        <rdfs:label>polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_60164 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_60164">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_60027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_53368"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An ionic polymer is a polymer, composed of ionic macromolecules.</obo:IAO_0000115>
        <rdfs:label>ionic polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_60242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_60242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36915"/>
        <obo:IAO_0000115>An atom or small molecule with a positive charge that does not contain carbon in covalent linkage, with a valency of one.</obo:IAO_0000115>
        <rdfs:label>monovalent inorganic cation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_60466 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_60466">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27369"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_tautomer_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16670"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Zwitterionic form of any peptide where, in general, the amino terminus is positively charged and the carboxy terminus is negatively charged.</obo:IAO_0000115>
        <rdfs:label>peptide zwitterion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_61115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_61115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76807"/>
        <obo:IAO_0000115>An EC 3.5.1.* (non-peptide linear amide C-N hydrolase) inhibitor that interferes with the function of histone deacetylase (EC 3.5.1.98).</obo:IAO_0000115>
        <rdfs:label>EC 3.5.1.98 (histone deacetylase) inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_61120 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_61120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33833"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51143"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#has_functional_parent"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18282"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any compound that has a nucleobase as a part.</obo:IAO_0000115>
        <rdfs:label>nucleobase-containing molecular entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_61469 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_61469">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_60164"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_53309"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A polymer, composed of polyanion macromolecules.</obo:IAO_0000115>
        <rdfs:label>polyanionic polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_62488 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_62488">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33280"/>
        <obo:IAO_0000115>A molecular messenger in which the molecule is specifically involved in transmitting information between cells. Such molecules are released from the cell sending the signal, cross over the gap between cells by diffusion, and interact with specific receptors in another cell, triggering a response in that cell by activating a series of enzyme controlled reactions which lead to changes inside the cell.</obo:IAO_0000115>
        <rdfs:label>signalling molecule</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_63248 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_63248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51086"/>
        <obo:IAO_0000115>A substance that removes electrons from another reactant in a redox reaction.</obo:IAO_0000115>
        <rdfs:label>oxidising agent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_63299 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_63299">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_78616"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#has_functional_parent"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16646"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any organooxygen compound derived from a carbohydrate by replacement of one or more hydroxy group(s) by an amino group, a thiol group or similar heteroatomic groups. The term also includes derivatives of these compounds.</obo:IAO_0000115>
        <rdfs:label>carbohydrate derivative</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_63436 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_63436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_63299"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#has_functional_parent"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33720"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_acid_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_63551"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A carbohydrate derivative that is formally obtained from a carbohydrate acid.</obo:IAO_0000115>
        <rdfs:label>carbohydrate acid derivative</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_63534 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_63534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64365"/>
        <obo:IAO_0000115>An aralylamino compound which contains one amino group connected to an aromatic ring by a two-carbon chain. Monoamines are derived from aromatic amino acids like phenylalanine, tyrosine, tryptophan, and the thyroid hormones by the action of aromatic amino acid decarboxylase enzymes.</obo:IAO_0000115>
        <rdfs:label>monoamine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_63551 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_63551">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_29067"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#has_functional_parent"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33721"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_base_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_63436"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A carboxylic acid anion resulting from the deprotonation of the carboxy group of a carbohydrate acid derivative.</obo:IAO_0000115>
        <rdfs:label>carbohydrate acid derivative anion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33232"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_78295"/>
        <obo:IAO_0000115>Any substance which is added to food to preserve or enhance its flavour and/or appearance.</obo:IAO_0000115>
        <rdfs:label>food additive</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64047"/>
        <obo:IAO_0000115>A food additive that is used to change or otherwise control the acidity or alkalinity of foods. They may be acids, bases, neutralising agents or buffering agents.</obo:IAO_0000115>
        <rdfs:label>food acidity regulator</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64365 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50047"/>
        <obo:IAO_0000115>An organic amino compound in which an aminoalkyl group is linked to an arene.</obo:IAO_0000115>
        <rdfs:label>aralkylamino compound</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64628 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64628">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24533"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25905"/>
        <obo:IAO_0000115>A fourteen-membered heterodetic cyclic peptide comprising the sequence Ala-Gly-Cys-Lys-Asn-Phe-Phe-Trp-Lys-Thr-Phe-Thr-Ser-Cys cyclised by a disulfide bridge between the two Cys residues at positions 3 and 14.</obo:IAO_0000115>
        <rdfs:label>somatostatin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64708 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64708">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50860"/>
        <obo:IAO_0000115>An organic molecular entity containing a single carbon atom (C1).</obo:IAO_0000115>
        <rdfs:label>one-carbon compound</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64709 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64709">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50860"/>
        <obo:IAO_0000115>Any organic molecular entity that is acidic and contains carbon in covalent linkage.</obo:IAO_0000115>
        <rdfs:label>organic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64766 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64766">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24433"/>
        <obo:IAO_0000115>A group that carries an overall positive charge.</obo:IAO_0000115>
        <rdfs:label>cationic group</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64767 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64767">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24433"/>
        <obo:IAO_0000115>A group that carries an overall negative charge.</obo:IAO_0000115>
        <rdfs:label>anionic group</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64769 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64769">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64766"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_acid_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33247"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cationic group that contains carbon.</obo:IAO_0000115>
        <rdfs:label>organic cationic group</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64775 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64775">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64767"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_base_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33247"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An anionic group that contains carbon.</obo:IAO_0000115>
        <rdfs:label>organic anionic group</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64898 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64898">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64775"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_base_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33708"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An amino-acid residue carrying an overall negative charge.</obo:IAO_0000115>
        <rdfs:label>anionic amino-acid residue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_64909 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64909">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24432"/>
        <obo:IAO_0000115>Any substance that causes disturbance to organisms by chemical reaction or other activity on the molecular scale, when a sufficient quantity is absorbed by the organism.</obo:IAO_0000115>
        <rdfs:label>poison</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_65212 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_65212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_167559"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33694"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_63299"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#has_functional_parent"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18154"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A carbohydrate derivative that is any derivative of a polysaccharide.</obo:IAO_0000115>
        <rdfs:label>polysaccharide derivative</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_65255 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_65255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64047"/>
        <obo:IAO_0000115>Substances which are added to food in order to prevent decomposition caused by  microbial growth or by undesirable chemical changes.</obo:IAO_0000115>
        <rdfs:label>food preservative</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_65256 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_65256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33281"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_65255"/>
        <obo:IAO_0000115>A food preservative which prevents decomposition of food by preventing the growth of fungi or bacteria. In European countries, E-numbers for permitted food preservatives are from E200 to E299, divided into sorbates (E200-209), benzoates (E210-219), sulfites (E220-229), phenols and formates (E230-239), nitrates (E240-259), acetates (E260-269), lactates (E270-279), propionates (E280-289) and others (E290-299).</obo:IAO_0000115>
        <rdfs:label>antimicrobial food preservative</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_65296 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_65296">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25697"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35274"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_acid_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50994"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An ammonium ion derivative resulting from the protonation of the nitrogen atom of a primary amino compound. Major species at pH 7.3.</obo:IAO_0000115>
        <rdfs:label>primary ammonium ion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_67079 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_67079">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33232"/>
        <obo:IAO_0000115>Any compound that has anti-inflammatory effects.</obo:IAO_0000115>
        <rdfs:label>anti-inflammatory agent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_71666 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_71666">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37022"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_base_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33707"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An amino-acid anion in which the amino group is situated gamma- to the carboxylate group.</obo:IAO_0000115>
        <rdfs:label>gamma-amino acid anion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_72587 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72587">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_166902"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_77746"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_acid_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18357"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An organic cation that is the conjugate acid of (R)-noradrenaline, obtained by protonation of the priamry amino group; major species at pH 7.3.</obo:IAO_0000115>
        <rdfs:label>(R)-noradrenaline(1+)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_72695 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72695">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25367"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50860"/>
        <obo:IAO_0000115>Any molecule that consists of at least one carbon atom as part of the electrically neutral entity.</obo:IAO_0000115>
        <rdfs:label>organic molecule</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_72813 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_72813">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33694"/>
        <obo:IAO_0000115>A biomacromolecule composed of carbohydrate residues which is secreted by a microorganism into the surrounding environment.</obo:IAO_0000115>
        <rdfs:label>exopolysaccharide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_73398 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_73398">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_73541"/>
        <obo:IAO_0000115>A mancude heterobicyclic organic group consisting of a benzene ring fused to a pyrrole ring.</obo:IAO_0000115>
        <rdfs:label>indole skeleton</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_73541 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_73541">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_52845"/>
        <obo:IAO_0000115>A bicyclic organic group that contains both carbon and hetero atoms.</obo:IAO_0000115>
        <rdfs:label>organic heterobicyclic ring</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75763 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75763">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25212"/>
        <obo:IAO_0000115>Any  metabolite produced during a metabolic reaction in eukaryotes, the taxon that include members of the fungi, plantae and animalia kingdoms.</obo:IAO_0000115>
        <rdfs:label>eukaryotic metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75767 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75767">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75763"/>
        <obo:IAO_0000115>Any eukaryotic metabolite produced during a metabolic reaction in animals that include diverse creatures from sponges, insects to mammals.</obo:IAO_0000115>
        <rdfs:label>animal metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75768 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75768">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75767"/>
        <obo:IAO_0000115>Any animal metabolite produced during a metabolic reaction in mammals.</obo:IAO_0000115>
        <rdfs:label>mammalian metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75771 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75771">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75768"/>
        <obo:IAO_0000115>Any mammalian metabolite produced during a metabolic reaction in a mouse (Mus musculus).</obo:IAO_0000115>
        <rdfs:label>mouse metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75772 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75772">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76946"/>
        <obo:IAO_0000115>Any  fungal metabolite produced during a metabolic reaction in Baker&apos;s yeast (Saccharomyces cerevisiae).</obo:IAO_0000115>
        <rdfs:label>Saccharomyces cerevisiae metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_75787 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75787">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25212"/>
        <obo:IAO_0000115>Any metabolite produced during a metabolic reaction in prokaryotes, the taxon that include members of domains such as the bacteria and archaea.</obo:IAO_0000115>
        <rdfs:label>prokaryotic metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_76206 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_76206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25212"/>
        <obo:IAO_0000115>Any metabolite produced by metabolism of a xenobiotic compound.</obo:IAO_0000115>
        <rdfs:label>xenobiotic metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_76759 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_76759">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23924"/>
        <obo:IAO_0000115>Any enzyme inhibitor that interferes with the action of a hydrolase (EC 3.*.*.*).</obo:IAO_0000115>
        <rdfs:label>EC 3.* (hydrolase) inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_76764 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_76764">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76759"/>
        <obo:IAO_0000115>Any hydrolase inhibitor that interferes with the action of a hydrolase acting on C-N bonds, other than peptide bonds (EC 3.5.*.*).</obo:IAO_0000115>
        <rdfs:label>EC 3.5.* (hydrolases acting on non-peptide C-N bonds) inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_76807 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_76807">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76764"/>
        <obo:IAO_0000115>An EC 3.5.* (hydrolases acting on non-peptide C-N bonds) inhibitor that interferes with the action of any non-peptide linear amide C-N hydrolase (EC 3.5.1.*).</obo:IAO_0000115>
        <rdfs:label>EC 3.5.1.* (non-peptide linear amide C-N hydrolase) inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_76924 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_76924">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75763"/>
        <obo:IAO_0000115>Any eukaryotic metabolite produced during a metabolic reaction in plants, the kingdom that include flowering plants, conifers and other gymnosperms.</obo:IAO_0000115>
        <rdfs:label>plant metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_76946 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_76946">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75763"/>
        <obo:IAO_0000115>Any eukaryotic metabolite produced during a metabolic reaction in fungi, the kingdom that includes microorganisms such as the yeasts and moulds.</obo:IAO_0000115>
        <rdfs:label>fungal metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_76967 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_76967">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76206"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_77746"/>
        <obo:IAO_0000115>Any human metabolite produced by metabolism of a xenobiotic compound in humans.</obo:IAO_0000115>
        <rdfs:label>human xenobiotic metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_76969 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_76969">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75787"/>
        <obo:IAO_0000115>Any prokaryotic metabolite produced during a metabolic reaction in bacteria.</obo:IAO_0000115>
        <rdfs:label>bacterial metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_76971 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_76971">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76969"/>
        <obo:IAO_0000115>Any bacterial metabolite produced during a metabolic reaction in Escherichia coli.</obo:IAO_0000115>
        <rdfs:label>Escherichia coli metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_77746 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_77746">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75768"/>
        <obo:IAO_0000115>Any mammalian metabolite  produced during a metabolic reaction in humans (Homo sapiens).</obo:IAO_0000115>
        <rdfs:label>human metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_77941 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_77941">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76807"/>
        <obo:IAO_0000115>An EC 3.5.1.* (non-peptide linear amide C-N hydrolase) inhibitor that interferes with the action of amidase (EC 3.5.1.4).</obo:IAO_0000115>
        <rdfs:label>EC 3.5.1.4 (amidase) inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_77974 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_77974">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64047"/>
        <obo:IAO_0000115>A food additive that is a (generally inert) gas which is used to envelop foodstuffs during packing and so protect them from unwanted chemical reactions such as food spoilage or oxidation during subsequent transport and storage. The term includes propellant gases, used to expel foods from a container.</obo:IAO_0000115>
        <rdfs:label>food packaging gas</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_78115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_78115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_58951"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_58953"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_base_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_140601"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any saturated fatty acid anion containing 4 carbons. Formed by deprotonation of the carboxylic acid moiety. Major species at pH 7.3.</obo:IAO_0000115>
        <rdfs:label>fatty acid anion 4:0</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_78295 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_78295">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_52211"/>
        <obo:IAO_0000115>A physiological role played by any substance that is distributed in foodstuffs. It includes materials derived from plants or animals, such as vitamins or minerals, as well as environmental contaminants.</obo:IAO_0000115>
        <rdfs:label>food component</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_78433 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_78433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33232"/>
        <obo:IAO_0000115>A substance used in a thermodynamic heat pump cycle or refrigeration cycle that undergoes a phase change from a gas to a liquid and back. Refrigerants are used in air-conditioning systems and freezers or refrigerators and are assigned a &quot;R&quot; number (by ASHRAE - formerly the American Society of Heating, Refrigerating and Air Conditioning Engineers), which is determined systematically according to their molecular structure.</obo:IAO_0000115>
        <rdfs:label>refrigerant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_78608 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_78608">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35238"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_tautomer_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33704"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An amino acid-zwitterion obtained by transfer of a proton from the carboxy to the amino group of any alpha-amino acid; major species at pH 7.3.</obo:IAO_0000115>
        <rdfs:label>alpha-amino-acid zwitterion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_78616 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_78616">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36963"/>
        <obo:IAO_0000115>Any organooxygen compound that is a polyhydroxy-aldehyde or -ketone, or a compound derived from one. Carbohydrates contain only carbon, hydrogen and oxygen and usually have an empirical formula Cm(H2O)n; carbohydrate derivatives may contain other elements by substitution or condensation.</obo:IAO_0000115>
        <rdfs:label>carbohydrates and carbohydrate derivatives</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_78675 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_78675">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25212"/>
        <obo:IAO_0000115>Any metabolite produced by all living cells.</obo:IAO_0000115>
        <rdfs:label>fundamental metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_79388 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_79388">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24834"/>
        <obo:IAO_0000115>Any inorganic anion with a valency of two.</obo:IAO_0000115>
        <rdfs:label>divalent inorganic anion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_79389 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_79389">
