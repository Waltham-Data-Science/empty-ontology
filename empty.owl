                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33704"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An amino-acid residue derived from an alpha-amino acid.</obo:IAO_0000115>
        <rdfs:label>alpha-amino-acid residue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_33719 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_33719">
