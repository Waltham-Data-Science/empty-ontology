                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_78608"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An amino acid in which the amino group is located on the carbon atom at the position alpha to the carboxy group.</obo:IAO_0000115>
        <rdfs:label>alpha-amino acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_33707 -->

