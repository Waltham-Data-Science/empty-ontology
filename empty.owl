                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_71666"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A non-proteinogenic amino-acid in which the amino group is located on the carbon atom at the position gamma to the carboxy group.</obo:IAO_0000115>
        <rdfs:label>gamma-amino acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_33708 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_33708">
