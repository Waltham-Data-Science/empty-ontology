                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33703"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A carboxylic acid containing one or more amino groups.</obo:IAO_0000115>
        <rdfs:label>amino acid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_33710 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_33710">
