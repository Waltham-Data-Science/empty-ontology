    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CARO_0000000">
        <rdfs:label>anatomical entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_10545 -->

