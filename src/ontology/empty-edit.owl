AnnotationAssertion(rdfs:label obo:EMPTY_0000346 "release date"@en)
SubClassOf(obo:EMPTY_0000346 obo:NCIT_C25164)

# Class: obo:EMPTY_0000347 (genetic strain type)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000347 "Whether a strain is wild type, mutant or transgenic.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000347 "Its values are BAO wild type (BAO:0000089), NCIT Mutant (C25360) and OBI transgenic organism (OBI:1000048). BAO has no mutant or transgenic strain term (OLS, 2026-10-20).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000347 "genetic strain type"@en)
SubClassOf(obo:EMPTY_0000347 obo:OBI_0001404)

# Class: obo:EMPTY_0000348 (oblique illumination imaging)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000348 "Imaging a specimen lit from one side at a low angle, so that its edges and surface relief show as differences in brightness.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000348 "No ontology term found (OLS, 2026-10-20): NCIT Quantitative Oblique Back-Illumination Microscopy (C188767) is a microscopy method for thick specimens. In the Haley et al. (2025) C. elegans foraging dataset, the patch contrast videos: a camera over a backlit plate with a card passed between the light and the plate, so the bacterial patches show.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000348 "oblique illumination imaging"@en)
SubClassOf(obo:EMPTY_0000348 obo:OBI_0000185)

# Class: obo:EMPTY_0000349 (peak amplitude)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000349 "The height of a profile's peak above its value at a reference point.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000349 "In the Haley et al. (2025) C. elegans foraging dataset, borderAmplitude of analyzeLawnProfiles: a fluorescence profile's peak above its value at the bacterial patch's outer edge. The reference point is a parameter of each use.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000349 "peak amplitude"@en)
SubClassOf(obo:EMPTY_0000349 obo:OBI_0200000)

# Class: obo:EMPTY_0000350 (signed distance from the nearest bacterial patch edge)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000350 "The distance from a subject's point to the nearest edge of a bacterial patch, positive inside the patch and negative outside it.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000350 "Obsolete: replaced by signed distance to region boundary (EMPTY:0000384); the patch is the region, named by a condition that points at the region's mask, not part of the term (Jess Haley, 2026-10-22, did-schema tenet audit [O3 Haley terms general]). Use signed distance to region boundary (EMPTY:0000384). Before: As distanceLawnEdge in analyzeWormLabTracks (Haley et al. 2024): the signed distance transform of the patch mask, read at the tracked point.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000350 "EMPTY:0000384")
AnnotationAssertion(rdfs:label obo:EMPTY_0000350 "obsolete signed distance from the nearest bacterial patch edge"@en)
AnnotationAssertion(owl:deprecated obo:EMPTY_0000350 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000351 (target bacteria growth duration after seeding)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000351 "The planned time from when a bacterial patch was seeded to the start of the assay: the growth group an assay was prepared for, as distinct from the measured time.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000351 "In Haley et al. (2025), getExperimentInfo derives the group by rounding the measured growth to 12 h (growthCondition: 0, 12 or 48 h).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000351 "target bacteria growth duration after seeding"@en)
SubClassOf(obo:EMPTY_0000351 obo:EMPTY_0000119)

# Class: obo:EMPTY_0000352 (anterior end point)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000352 "The most anterior point of a subject's body along its midline (the leading point of a tracked body spline).")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000352 "A point, beside body midpoint (EMPTY:0000137); UBERON head (UBERON:0000033) is a region. In the Haley et al. (2025) dataset, the head point of the WormLab track.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000352 "anterior end point"@en)
SubClassOf(obo:EMPTY_0000352 obo:NCIT_C32221)

# Class: obo:EMPTY_0000353 (posterior end point)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000353 "The most posterior point of a subject's body along its midline (the trailing point of a tracked body spline).")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000353 "A point, beside body midpoint (EMPTY:0000137); UBERON tail (UBERON:0002415) is a region. In the Haley et al. (2025) dataset, the tail point of the WormLab track.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000353 "posterior end point"@en)
SubClassOf(obo:EMPTY_0000353 obo:NCIT_C32221)

# Class: obo:EMPTY_0000354 (material type)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000354 "The kind of non-living object or substance that a subject is.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000354 "No ontology term found (OLS, 2026-10-21): no Material Type or Substance Type term in NCIT, OBI, EFO, EDAM, IAO, STATO, PATO or BAO; NCIT Sample Type (C210102) names a sample. A sibling of NCIT Sample Type and Equipment Type (C178920) under NCIT Type. The binding variable for a material subject, such as an agar plate.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000354 "material type"@en)
SubClassOf(obo:EMPTY_0000354 obo:NCIT_C25284)

# Class: obo:EMPTY_0000355 (ethics assessment)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000355 "Whether the work recorded in a dataset required an ethics review and, if so, the outcome of that review.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000355 "Obsolete: replaced by ethics jurisdiction (EMPTY:0000359), Jess Haley 2026-10-21, following openMINDS v6 and later, which drop the ethicsAssessment terminology for ethicsJurisdiction. Minted the same day and never written by an import. Before: No ontology term found (OLS, 2026-10-21): IAO ethical approval textual entity (IAO:0000621) is a document and OBI ethical standard compliance rule (OBI:0500025) is a rule; neither names the property.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000355 "obsolete ethics assessment"@en)
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000355 "EMPTY:0000359")
AnnotationAssertion(owl:deprecated obo:EMPTY_0000355 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000356 (experimental approach)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000356 "The general kind of scientific approach used to produce the data, such as electrophysiology, imaging or behavior.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000356 "No ontology term found (OLS, 2026-10-21): NCIT Research Technique (C20368) names a laboratory technique, which is narrower (behavior is not a lab technique), and NCIT Methodology (C86572) names a discipline's system of methods.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000356 "experimental approach"@en)
SubClassOf(obo:EMPTY_0000356 obo:NCIT_C25284)

# Class: obo:EMPTY_0000357 (culture type)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000357 "The kind of culture that a subject is.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000357 "No ontology term found (OLS, 2026-10-21; NCIT, OBI, EFO, MICRO, BAO): NCIT Adherent Culture (C20216), Suspension Culture (C20217) and Flask or Bottle Culture (C112954) are kinds of culture, not the variable; NCIT CDISC SDTM Culture Medium Type Terminology (C127264) names a codelist of media; SNOMED Culture typing procedure (104236001) is a procedure; NCIT Sample Type (C210102) names a sample. A sibling of material type (EMPTY:0000354) and NCIT Sample Type under NCIT Type. The binding variable for a culture subject, such as a bacterial patch on agar.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000357 "culture type"@en)
SubClassOf(obo:EMPTY_0000357 obo:NCIT_C25284)

# Class: obo:EMPTY_0000358 (optogenetic tetanus stimulation)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000358 "Stimulation of neurons that express a light-gated ion channel with a train of light pulses at high frequency (a tetanus), delivered to a target location to drive sustained activity there.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000358 "No ontology term found (OLS4, 2026-10-21; NCIT, OBI, EFO, MMO, then all ontologies; queries optogenetic stimulation, optogenetic tetanus, tetanic stimulation, tetanus, high frequency stimulation, photostimulation, optogenetics): NCIT Stimulation (C61406) is the general class, too broad to name the method; MeSH Optogenetics (D062308) and OMIT Optogenetics (0028070) name the technique family, not a stimulation protocol; ECO optogenetic evidence (0006032) is an evidence type; SNOMED Tetanic burst stimulation (264602007) and Tetanic stimulation monitoring (397979003) are clinical electrical neuromuscular procedures; NCIT Tetanus (C85185) and MONDO tetanus (0005526) are the disease; NBO photostimulation induced seizure (0000737) is a behaviour. Under NCIT Stimulation. The method of the tetanic light stimulation (TLS) in the Dabrowska slice recordings, applied at the target location EMPTY:0000074.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000358 "optogenetic tetanus stimulation"@en)
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:EMPTY_0000358 "TLS"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:EMPTY_0000358 "tetanic light stimulation"@en)
SubClassOf(obo:EMPTY_0000358 obo:NCIT_C61406)

# Class: obo:EMPTY_0000359 (ethics jurisdiction)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000359 "The jurisdiction, a sovereign state or a supranational body, under which the ethics assessment of the work recorded in a dataset was conducted.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000359 "No ontology term found (OLS4, 2026-10-21; queries ethics jurisdiction, jurisdiction): NCIT Jurisdiction (C79890), DCTERMS Jurisdiction and ICO jurisdiction (0000231) name a territory or an authority, not the property of a dataset. Follows openMINDS (v6 and later) ethicsJurisdiction, whose values are the openMINDS sovereignState and supranationalBody terminologies. The binding variable for a dataset; replaces ethics assessment (EMPTY:0000355). Jess Haley, 2026-10-21.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000359 "ethics jurisdiction"@en)
SubClassOf(obo:EMPTY_0000359 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000360 (chemogenetics)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000360 "Any experimental approach focused on using genetically encoded chemically sensitive proteins in combination with a specific agonist delivered systemically in order to manipulate the behavior of populations of cells.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000360 "An openMINDS (latest) experimentalApproach that carries no ontology identifier; label and definition are openMINDS's. Near matches (OLS4, 2026-10-21, exact label search): MeSH Chemogenetics (D000098972) names the technique, and mesh is not a prefix NDI registers. A value of experimental approach (EMPTY:0000356). Jess Haley, 2026-10-21.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000360 "chemogenetics"@en)
SubClassOf(obo:EMPTY_0000360 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000361 (genetics)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000361 "Any experimental approach that measures or manipulates some aspect of the genetic material of an organism.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000361 "An openMINDS (latest) experimentalApproach that carries no ontology identifier; label and definition are openMINDS's. Near matches (OLS4, 2026-10-21, exact label search): NCIT Genetics (C16624) and EDAM Genetics (topic_3053) name the branch of biology, not an experimental approach. A value of experimental approach (EMPTY:0000356). Jess Haley, 2026-10-21.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000361 "genetics"@en)
SubClassOf(obo:EMPTY_0000361 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000362 (informatics)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000362 "Any experimental approach focused on collection, classification, storage, retrieval, analysis, visualization, and dissemination of recorded knowledge in computational systems.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000362 "An openMINDS (latest) experimentalApproach that carries no ontology identifier; label and definition are openMINDS's. Near matches (OLS4, 2026-10-21, exact label search): NCIT Informatics (C18145) names an occupational discipline and EDAM Informatics (topic_0605) a field of study, not an experimental approach. A value of experimental approach (EMPTY:0000356). Jess Haley, 2026-10-21.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000362 "informatics"@en)
SubClassOf(obo:EMPTY_0000362 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000363 (optogenetics)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000363 "Any experimental approach focused on using genetically encoded light-sensitive proteins in combination with targeted delivery of light in order to manipulate the behavior of populations of cells.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000363 "An openMINDS (latest) experimentalApproach that carries no ontology identifier; label and definition are openMINDS's. Near matches (OLS4, 2026-10-21, exact label search): MeSH Optogenetics (D062308) and OMIT Optogenetics (0028070) name the technique family; ECO optogenetic evidence (0006032) is an evidence type. A value of experimental approach (EMPTY:0000356). Jess Haley, 2026-10-21.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000363 "optogenetics"@en)
SubClassOf(obo:EMPTY_0000363 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000364 (pathology)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000364 "Any experimental approach that aims to identify or classify the causes and effects of diseases, disorders, injuries, or other abnormal biology.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000364 "An openMINDS (latest) experimentalApproach that carries no ontology identifier; label and definition are openMINDS's. Near matches (OLS4, 2026-10-21, exact label search): NCIT Pathology (C18189) and EDAM Pathology (topic_0634) name the medical specialty or topic, not an experimental approach. A value of experimental approach (EMPTY:0000356). Jess Haley, 2026-10-21.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000364 "pathology"@en)
SubClassOf(obo:EMPTY_0000364 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000365 (number of organisms per arena)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000365 "The number of organisms placed together in one arena for an assay.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000365 "No ontology term found (OLS4, 2026-10-21; queries number of organisms per arena, animals per arena, number of animals, number of organisms, organism count, group size, population size, animals per cage): NCIT Number of Animals Affected (C88075) and Total Number of Study Animals Purchased (C130198) count animals in a study; MIXS animal_group_size (0001129) counts food animals kept together; MIXS and PRIDE organism count count cells in a sample; GECKO population size (0000008) is a sample size. A factor of the Haley single-patch assays (4 worms per arena for the large patch, 1 for the small). Jess Haley, 2026-10-21.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000365 "number of organisms per arena"@en)
SubClassOf(obo:EMPTY_0000365 obo:EMPTY_0000080)

# Class: obo:EMPTY_0000366 (flashed bar)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000366 "A stationary bar of uniform luminance presented briefly against the background.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000366 "No ontology term found (OLS4, 2026-10-22; queries flashed bar, flashed bar stimulus, bar stimulus, bar of light, visual stimulus, visual stimulation): XCO visual stimulus (0000049) and NCIT Stimulus (C41210) are general classes that do not name the stimulus kind; NCIT Checkerboard Square Size (C117759) is a checkerboard property. This ontology has no visual stimulus class, so under NCIT Stimulation as the other stimulation method term (EMPTY:0000358) is. The kind of a NewStim periodicstim with imageType 0 drawn in a narrow oriented rectangle (VH-Lab/vhlab-NewStim-matlab @periodicstim/periodicstim.m); light versus dark is a parameter, not part of the term. Source: did-schema V_eta_method_plan.md [flashed bar]. Jess Haley, 2026-10-22.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000366 "flashed bar"@en)
SubClassOf(obo:EMPTY_0000366 obo:NCIT_C61406)

# Class: obo:EMPTY_0000367 (NDI binary format)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000367 "NDI's binary container (ndi_binary_version 1): a gzip-compressed tar of an .nbh header and an .nbf data file, as written by NDI-compress write_ndibinary (.nbf.tgz).")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000367 "No ontology term found (OLS4, 2026-10-22; queries NDI binary, nbf): EDAM Binary format (format_2333) is the general class, too broad to name the layout. Written by Waltham-Data-Science/NDI-compress +ndi/+compress/write_ndibinary.m; compress_metadata, compress_ephys, compress_digital, compress_time and compress_eventmarktext all write it. First used for the ingested stimulus metadata archive (v1 daqmetadatareader_epochdata_ingested data.bin). Under EDAM Binary format. Source: did-schema V_eta_data_body_model_plan.md [NDI binary format]. Jess Haley, 2026-10-22.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000367 "NDI binary format"@en)
SubClassOf(obo:EMPTY_0000367 obo:format_2333)

# Class: obo:EMPTY_0000368 (onset time)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000368 "The time at which the thing a position stands for (a stimulus, an event) comes into effect or becomes present, as distinct from the start of any preparation or period around it.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000368 "Source: did-schema V_eta_data_body_model_plan.md AMENDMENT 6 [onset time]; NDI +app/+stimulus/decoder.m records onset/offset (the stimulus itself) apart from stimopen/stimclose (the period around it). No existing term means this (OLS4, 2026-10-22: 'onset time' 8 hits, all clinical; 'stimulus onset' 0; NCIT Onset C25279 is a temporal qualifier; SIO start time 000669 / NCIT Start Time C78441 mean the start of a process, which for a presentation is stimopen). Decided by Jess Haley, 2026-10-22 (did-schema V_eta_data_body_model_plan.md [onset and offset terms]); it replaces EMPTY:0000140 encounter onset time.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000368 "onset time"@en)
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:EMPTY_0000368 "start time"@en)
SubClassOf(obo:EMPTY_0000368 obo:EMPTY_0000091)

# Class: obo:EMPTY_0000369 (offset time)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000369 "The time at which the thing a position stands for (a stimulus, an event) ceases to be in effect or present, as distinct from the end of any period around it.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000369 "Source: did-schema V_eta_data_body_model_plan.md AMENDMENT 6 [onset time] (its pair); NDI +app/+stimulus/decoder.m records onset/offset (the stimulus itself) apart from stimopen/stimclose (the period around it). No existing term means this (OLS4, 2026-10-22: 'onset time' 8 hits, all clinical; 'stimulus onset' 0; NCIT Onset C25279 is a temporal qualifier; SIO start time 000669 / NCIT Start Time C78441 mean the start of a process, which for a presentation is stimopen). Decided by Jess Haley, 2026-10-22 (did-schema V_eta_data_body_model_plan.md [onset and offset terms]); it replaces EMPTY:0000140 encounter onset time.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000369 "offset time"@en)
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:EMPTY_0000369 "end time"@en)
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:EMPTY_0000369 "stop time"@en)
SubClassOf(obo:EMPTY_0000369 obo:EMPTY_0000091)

# Class: obo:EMPTY_0000370 (analog input channel)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000370 "A channel through which an acquisition system samples a continuously valued signal.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000370 "A hardware channel type of acquisition_channels.channels.type; the exact synonym 'ai' is the standard data-acquisition abbreviation, and also the NDI v1 channel prefix (the migrator maps prefix to term, NDI maps term to prefix for its readers). Under NCIT Channel (C44170), the root of the channel-type binding, whose other two values are NCIT Metadata (C52095, v1 md) and NCIT Text (C25704, v1 tx). The 8 derived read modes (dep den dimp dimn aep aen aimp aimn) get no terms. No ontology term found (OLS4, 2026-10-22, label and synonym search; queries analog input, analog input channel, analog output, digital input, digital output, auxiliary input, time channel, event channel, marker channel, trigger channel, event marker: 0 hits each). Source: Jess Haley, 2026-10-22, did-schema tenet audit [B2 channel types].")
AnnotationAssertion(rdfs:label obo:EMPTY_0000370 "analog input channel"@en)
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:EMPTY_0000370 "ai"@en)
SubClassOf(obo:EMPTY_0000370 obo:NCIT_C44170)

# Class: obo:EMPTY_0000371 (analog output channel)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000371 "A channel through which an acquisition system emits a continuously valued signal.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000371 "A hardware channel type of acquisition_channels.channels.type; the exact synonym 'ao' is the standard data-acquisition abbreviation, and also the NDI v1 channel prefix (the migrator maps prefix to term, NDI maps term to prefix for its readers). Under NCIT Channel (C44170), the root of the channel-type binding, whose other two values are NCIT Metadata (C52095, v1 md) and NCIT Text (C25704, v1 tx). The 8 derived read modes (dep den dimp dimn aep aen aimp aimn) get no terms. No ontology term found (OLS4, 2026-10-22, label and synonym search; queries analog input, analog input channel, analog output, digital input, digital output, auxiliary input, time channel, event channel, marker channel, trigger channel, event marker: 0 hits each). Source: Jess Haley, 2026-10-22, did-schema tenet audit [B2 channel types].")
AnnotationAssertion(rdfs:label obo:EMPTY_0000371 "analog output channel"@en)
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:EMPTY_0000371 "ao"@en)
SubClassOf(obo:EMPTY_0000371 obo:NCIT_C44170)

# Class: obo:EMPTY_0000372 (digital input channel)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000372 "A channel through which an acquisition system samples a two-state signal.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000372 "A hardware channel type of acquisition_channels.channels.type; the exact synonym 'di' is the standard data-acquisition abbreviation, and also the NDI v1 channel prefix (the migrator maps prefix to term, NDI maps term to prefix for its readers). Under NCIT Channel (C44170), the root of the channel-type binding, whose other two values are NCIT Metadata (C52095, v1 md) and NCIT Text (C25704, v1 tx). The 8 derived read modes (dep den dimp dimn aep aen aimp aimn) get no terms. No ontology term found (OLS4, 2026-10-22, label and synonym search; queries analog input, analog input channel, analog output, digital input, digital output, auxiliary input, time channel, event channel, marker channel, trigger channel, event marker: 0 hits each). Source: Jess Haley, 2026-10-22, did-schema tenet audit [B2 channel types].")
AnnotationAssertion(rdfs:label obo:EMPTY_0000372 "digital input channel"@en)
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:EMPTY_0000372 "di"@en)
SubClassOf(obo:EMPTY_0000372 obo:NCIT_C44170)

