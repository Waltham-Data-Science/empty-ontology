SubClassOf(obo:EMPTY_0000050 obo:EMPTY_0000003)
SubClassOf(obo:EMPTY_0000050 obo:EMPTY_0000090)

# Class: obo:EMPTY_0000051 (elevated plus maze: test identifier)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000051 "For an Elevated Plus Maze experiment, this is a unique code or descriptive name assigned to identify a specific experimental session, trial, or a particular set of recorded data. It helps in organizing and referencing data from distinct observations.")
