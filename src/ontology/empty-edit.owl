AnnotationAssertion(rdfs:label obo:EMPTY_0000338 "eyelash picking"@en)
SubClassOf(obo:EMPTY_0000338 obo:COB_0000035)

# Class: obo:EMPTY_0000339 (cleaning step)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000339 "A parameter of a transfer: how the organisms were freed of adhering material, such as bacteria, before being placed on the next plate.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000339 "cleaning step"@en)
SubClassOf(obo:EMPTY_0000339 obo:EMPTY_0000080)

# Class: obo:EMPTY_0000340 (droplet)

