AnnotationAssertion(rdfs:label obo:EMPTY_0000132 "obsolete bacterial patch closest identifier map"@en)
AnnotationAssertion(rdfs:comment obo:EMPTY_0000132 "Obsolete: a variable names the property, not the form its values are stored in (T16 of the NDI V_eta tenets). Use nearest bacterial patch (EMPTY:0000297); that the values form a map is said by the statement's keys. Kept for the v1 Haley et al. (2025) dataset, which may cite it.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000132 "EMPTY:0000297")
AnnotationAssertion(owl:deprecated obo:EMPTY_0000132 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000133 (bacterial patch fluorescence image (normalized))

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000133 "An image of fluorescently labeled bacterial patches that has been processed to correct for uneven illumination. This is achieved by dividing the raw fluorescence image by a corresponding, smoothed background image (typically of an empty agar plate), thereby removing illumination-dependent spatial variance in the signal intensity. Unit: dimensionless.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000133 "bacterial patch fluorescence image (normalized)"@en)
