AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000343 "The posterior probability of sensing below which an encounter is classed an off-patch search encounter, together with the distance rule.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000343 "off-patch search encounter: probability of sensing below"@en)
SubClassOf(obo:EMPTY_0000343 obo:STATO_0000633)

# Class: obo:EMPTY_0000344 (off-patch search encounter: maximum distance into the patch)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000344 "The greatest distance into the patch an encounter can reach and still be classed an off-patch search encounter.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000344 "off-patch search encounter: maximum distance into the patch"@en)
SubClassOf(obo:EMPTY_0000344 obo:STATO_0000633)

# Class: obo:EMPTY_0000345 (publication date)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000345 "The date on which a publication was published.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000345 "NCIT Study Publication Date (C142711) is limited to clinical studies.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000345 "publication date"@en)
SubClassOf(obo:EMPTY_0000345 obo:NCIT_C25164)

# Class: obo:EMPTY_0000346 (release date)

