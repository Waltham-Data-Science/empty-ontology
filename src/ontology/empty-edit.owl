AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000066 "The specific date and time indicating when an individual experimental trial was conducted or its data recorded.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000066 "experiment trial execution timestamp"@en)
SubClassOf(obo:EMPTY_0000066 obo:EMPTY_0000089)

