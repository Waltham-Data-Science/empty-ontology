AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000125 "The Y pixel coordinate representing the geometric center of an individual detected bacterial food patch within an assay arena. Unit: pixels.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000125 "bacterial patch center: Y coordinate"@en)
SubClassOf(obo:EMPTY_0000125 obo:EMPTY_0000161)
SubClassOf(obo:EMPTY_0000125 obo:NCIT_C44478)

# Class: obo:EMPTY_0000126 (bacterial patch radius)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000126 "The radius of an individual detected bacterial patch on an agar plate, assuming patches are circular or near-circular. Unit: pixels.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000126 "obsolete bacterial patch radius"@en)
AnnotationAssertion(rdfs:comment obo:EMPTY_0000126 "Obsolete: a variable names the property; the subject and whether the value is a target are said by the statement (T16, T17 of the NDI V_eta tenets). Use radius (PATO:0002390) on the patch for a measured radius; a target size is diameter (PATO:0001334) with the condition value basis (EMPTY:0000298) = target (EMPTY:0000299). Kept for the v1 Haley et al. (2025) dataset, which may cite it.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000126 "PATO:0002390")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000126 "PATO:0001334")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000126 "EMPTY:0000299")
AnnotationAssertion(owl:deprecated obo:EMPTY_0000126 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000127 (bacterial patch circularity)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000127 "A quantitative measure assessing how closely the shape of an individual detected bacterial patch conforms to a perfect circle. 1 is a perfect circle. [Source: https://www.mathworks.com/help/images/ref/regionprops.html]")
AnnotationAssertion(rdfs:label obo:EMPTY_0000127 "obsolete bacterial patch circularity"@en)
AnnotationAssertion(rdfs:comment obo:EMPTY_0000127 "Obsolete: a summary of a general quantity is stated as that quantity, with its statistic as the method and what it is about as conditions (T16 of the NDI V_eta tenets). Use circularity (EMPTY:0000288) on a statement about the patch: the patch is the statement's subject, so it is not part of the variable. Kept for the v1 Haley et al. (2025) dataset, which may cite it.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000127 "EMPTY:0000288")
AnnotationAssertion(owl:deprecated obo:EMPTY_0000127 "true"^^xsd:boolean)

