SubClassOf(obo:EMPTY_0000119 obo:EMPTY_0000161)

# Class: obo:EMPTY_0000120 (bacterial patch volume)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000120 "The volume of bacterial solution pipetted to create an individual patch on an agar plate.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000120 "Obsolete: replaced by seeding volume (EMPTY:0000385); the bacteria and the patch are said by the document, not the term (Jess Haley, 2026-10-22, did-schema tenet audit [O3 Haley terms general]). Use seeding volume (EMPTY:0000385).")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000120 "EMPTY:0000385")
AnnotationAssertion(rdfs:label obo:EMPTY_0000120 "obsolete bacterial patch volume"@en)
AnnotationAssertion(owl:deprecated obo:EMPTY_0000120 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000121 (bacterial patch spacing (target))

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000121 "The intended center-to-center distance between adjacent bacterial food patches when arranged in a grid on an agar plate. Unit: millimeters (mm).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000121 "obsolete bacterial patch spacing (target)"@en)
AnnotationAssertion(rdfs:comment obo:EMPTY_0000121 "Obsolete: a variable names the property; the subject and whether the value is a target are said by the statement (T16, T17 of the NDI V_eta tenets). Use spacing (NCIT:C45786) on the plate, with the condition value basis (EMPTY:0000298) = target (EMPTY:0000299). Kept for the v1 Haley et al. (2025) dataset, which may cite it.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000121 "NCIT:C45786")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000121 "EMPTY:0000299")
AnnotationAssertion(owl:deprecated obo:EMPTY_0000121 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000122 (arena diameter)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000122 "The diameter of the arena: the bounded region in which an experiment's subjects are confined and observed.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000122 "Obsolete: replaced by diameter (PATO:0001334); the arena-mask method parameter is a diameter; the arena is said by the document, not the term (Jess Haley, 2026-10-22, did-schema tenet audit [O3 Haley terms general]). Use diameter (PATO:0001334). Before: Generalised 2026-10-20 (tenet T19): the label and definition no longer name C. elegans or a plate, which the statement's subject and session already say; the unit is stored on the value. Formerly 'C. elegans behavioral assay: plate or arena diameter'.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000122 "PATO:0001334")
AnnotationAssertion(rdfs:label obo:EMPTY_0000122 "obsolete arena diameter"@en)
AnnotationAssertion(owl:deprecated obo:EMPTY_0000122 "true"^^xsd:boolean)

