AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000271 "A solution of cholesterol in ethanol, kept as a stock for adding cholesterol to nematode culture media. Its concentration is a property of each preparation, not of this class.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:EMPTY_0000271 "cholesterol in ethanol"@en)
AnnotationAssertion(rdfs:label obo:EMPTY_0000271 "cholesterol solution"@en)
SubClassOf(obo:EMPTY_0000271 obo:NCIT_C70830)

# Class: obo:EMPTY_0000272 (peak speed before an event)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000272 "A data transformation that finds an animal's peak speed in the approach to an event: within a window before the event, it takes the last time point at which the animal was still accelerating, then the highest speed within a short neighbourhood of that time point. The window and the neighbourhood are parameters of each use.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000272 "As used for velocityBeforeEnter by analyzeEncounters (Haley et al. 2024): a 10 s window before the start of a patch encounter and a 1 s neighbourhood. Not the maximum over the window.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000272 "peak speed before an event"@en)
SubClassOf(obo:EMPTY_0000272 obo:OBI_0200000)

# Class: obo:EMPTY_0000273 (minimum speed after an event)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000273 "A data transformation that finds an animal's lowest speed after an event: the minimum speed within a window after the event, but no lower than the minimum speed over the whole of the event, so that slowing after the event has ended is not counted. The window is a parameter of each use.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000273 "As used for velocityAfterEnter by analyzeEncounters (Haley et al. 2024): a 10 s window after the start of a patch encounter, bounded below by the minimum speed during the encounter.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000273 "minimum speed after an event"@en)
SubClassOf(obo:EMPTY_0000273 obo:OBI_0200000)

# Class: obo:EMPTY_0000274 (time to slow down)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000274 "The time an animal takes to slow down on reaching something: the duration from its peak speed in the approach to an event to its minimum speed after the event.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000274 "As timeSlowDown in analyzeEncounters (Haley et al. 2024): from the time of the peak found by 'peak speed before an event' (EMPTY:0000272) to the time of the minimum found by 'minimum speed after an event' (EMPTY:0000273), around the start of a patch encounter.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000274 "time to slow down"@en)
SubClassOf(obo:EMPTY_0000274 obo:EMPTY_0000090)
SubClassOf(obo:EMPTY_0000274 obo:EMPTY_0000100)

# Class: obo:EMPTY_0000275 (entity in contact)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000275 "The entity a subject is in contact with during each of its encounters.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000275 "As lawnID in analyzeEncounters (Haley et al. 2024): one patch per encounter. Generalised 2026-10-20 (tenet T19) from 'bacterial patch in contact': the entities themselves say what they are.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000275 "entity in contact"@en)
SubClassOf(obo:EMPTY_0000275 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000276 (nearest bacterial patch edge)

