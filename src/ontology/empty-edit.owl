AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000124 "The X pixel coordinate representing the geometric center of an individual detected bacterial food patch within an assay arena. Unit: pixels.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000124 "bacterial patch center: X coordinate"@en)
SubClassOf(obo:EMPTY_0000124 obo:EMPTY_0000161)
