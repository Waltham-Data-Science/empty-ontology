AnnotationAssertion(rdfs:label obo:EMPTY_0000069 "data exclusion flag"@en)
SubClassOf(obo:EMPTY_0000069 obo:EMPTY_0000085)

# Class: obo:EMPTY_0000070 (type II BNST neuron)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000070 "A type of neuron located in the dorsolateral bed nucleus of the stria terminalis (BNSTDL) that produces post-inhibitory spikes in response to preceding negative current steps, which is related to the action of the low-threshold Ca2+ current. These neurons also display strong voltage sags under hyperpolarizing current pulses, indicating a high level of the hyperpolarization-activated cation current (Ih). [Source: https://doi.org/10.1016/j.celrep.2025.115768]")
AnnotationAssertion(rdfs:label obo:EMPTY_0000070 "type II BNST neuron"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:EMPTY_0000070 "type II neuron of the bed nucleus of the stria terminalis"@en)
SubClassOf(obo:EMPTY_0000070 obo:EMPTY_0000071)
SubClassOf(obo:EMPTY_0000070 obo:UBERON_0001880)

# Class: obo:EMPTY_0000071 (investigator-defined cell type)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000071 "A cell type proposed by an investigator on the basis of electrophysiological or anatomical criteria.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000071 "investigator-defined cell type"@en)
SubClassOf(obo:EMPTY_0000071 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000072 (type I BNST neuron)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000072 "A type of neuron located in the dorsolateral bed nucleus of the stria terminalis (BNSTDL) that fires regularly, displays moderate spike frequency adaptation, and exhibits a voltage sag indicating the presence of the hyperpolarization-activated cation current (Ih). [Source: https://doi.org/10.1016/j.celrep.2025.115768]")
AnnotationAssertion(rdfs:label obo:EMPTY_0000072 "type I BNST neuron"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:EMPTY_0000072 "type I neuron of the bed nucleus of the stria terminalis"@en)
SubClassOf(obo:EMPTY_0000072 obo:EMPTY_0000071)
SubClassOf(obo:EMPTY_0000072 obo:UBERON_0001880)

# Class: obo:EMPTY_0000073 (type III BNST neuron)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000073 "A type of neuron located in the dorsolateral bed nucleus of the stria terminalis (BNSTDL) characterized by a high rheobase, absence of voltage sag under negative current steps, prominent inward rectification due to the activation of the inward rectifying K+ current (IKIR) at membrane potentials more negative than approximately -50 mV, and firing onset after a characteristic slow voltage ramp mediated by the K+ delayed current (ID). [Source: https://doi.org/10.1016/j.celrep.2025.115768]")
AnnotationAssertion(rdfs:label obo:EMPTY_0000073 "type III BNST neuron"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:EMPTY_0000073 "type III neuron of the bed nucleus of the stria terminalis"@en)
SubClassOf(obo:EMPTY_0000073 obo:EMPTY_0000071)
SubClassOf(obo:EMPTY_0000073 obo:UBERON_0001880)

