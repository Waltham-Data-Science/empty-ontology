AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000149 "A normalized, quantitative measure of the bacterial density on the agar plates where C. elegans were cultivated prior to the behavioral assay. [Source: https://doi.org/10.7554/eLife.103191.2.sa4]")
AnnotationAssertion(rdfs:label obo:EMPTY_0000149 "obsolete C. elegans behavioral assay: relative density of cultivation bacteria"@en)
AnnotationAssertion(rdfs:comment obo:EMPTY_0000149 "Obsolete: replaced in the NDI V2 Haley import by relative cell density (EMPTY:0000322), stated on the cultivation (acclimation) plate's patch when the worms were picked; this term named one use of the quantity rather than the quantity. Kept for the v1 Haley et al. (2025) dataset, which may cite it.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000149 "EMPTY:0000322")
AnnotationAssertion(owl:deprecated obo:EMPTY_0000149 "true"^^xsd:boolean)

