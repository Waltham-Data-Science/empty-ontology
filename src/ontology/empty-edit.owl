AnnotationAssertion(owl:deprecated obo:EMPTY_0000138 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000139 (C. elegans behavioral assay: encounter identifier)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000139 "A unique numerical identifier assigned to a specific encounter event for a given animal. This distinguishes individual encounters for detailed analysis.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000139 "C. elegans behavioral assay: encounter identifier"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:EMPTY_0000139 "C. elegans behavioral assay: encounter ID"@en)
SubClassOf(obo:EMPTY_0000139 obo:EMPTY_0000083)

# Class: obo:EMPTY_0000140 (encounter onset time)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000140 "The time at which a subject's encounter begins.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000140 "Obsolete: replaced by onset time (EMPTY:0000368); the encounter is the position the onset time is a covariate along, not part of the term (Jess Haley, 2026-10-22; did-schema V_eta_data_body_model_plan.md [onset and offset terms]). Use onset time (EMPTY:0000368). Generalised 2026-10-20 (tenet T19); formerly 'C. elegans behavioral assay: encounter onset time'. Kept for the v1 Haley et al. (2025) dataset, which may cite it.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000140 "EMPTY:0000368")
AnnotationAssertion(rdfs:label obo:EMPTY_0000140 "obsolete encounter onset time"@en)
AnnotationAssertion(owl:deprecated obo:EMPTY_0000140 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000141 (C. elegans behavioral assay: encounter offset time)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000141 "The time, in seconds, corresponding to the frame at which the C. elegans worm exits a bacterial food patch. This is the precise end time of an encounter.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000141 "Obsolete: replaced by offset time (EMPTY:0000369); the encounter is the position the offset time is a covariate along, not part of the term (Jess Haley, 2026-10-22; as EMPTY:0000140 was replaced by onset time). Use offset time (EMPTY:0000369).")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000141 "EMPTY:0000369")
AnnotationAssertion(rdfs:label obo:EMPTY_0000141 "obsolete C. elegans behavioral assay: encounter offset time"@en)
AnnotationAssertion(owl:deprecated obo:EMPTY_0000141 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000142 (C. elegans behavioral assay: deceleration upon encounter)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000142 "The rate of change in the C. elegans worm's velocity, measured as the slope of the velocity curve during a defined time window surrounding its encounter with a bacterial patch. A negative value indicates a slowdown upon encounter. Unit: µm/s².")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000142 "Obsolete: a summary statistic over a window of a general quantity is stated as that quantity with the statistic as the statement's method and the window as a condition, not as a term of its own. Use acceleration (PATO:0001028) with the method ordinary least squares estimation (STATO:0000370), the slope of speed against time, and the conditions analysis window start -1.5 s (EMPTY:0000281) and end +6.5 s (EMPTY:0000282) from the encounter onset (NCIT:C82576 reference time point = EMPTY:0000140). Kept for the v1 Haley et al. (2025) dataset, which may cite it.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000142 "PATO:0001028")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000142 "STATO:0000370")
AnnotationAssertion(rdfs:label obo:EMPTY_0000142 "obsolete C. elegans behavioral assay: deceleration upon encounter"@en)
AnnotationAssertion(owl:deprecated obo:EMPTY_0000142 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000143 (C. elegans behavioral assay: minimum velocity during encounter)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000143 "The minimum instantaneous velocity recorded for the C. elegans worm while it is located on a bacterial food patch during an encounter. Unit: µm/s.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000143 "Obsolete: a summary statistic over a window of a general quantity is stated as that quantity with the statistic as the statement's method and the window as a condition, not as a term of its own. Use speed (PATO:0000008) with the method minimum (STATO:0000150) and the condition patch encounter period (EMPTY:0000277) = during the patch encounter (EMPTY:0000279). Kept for the v1 Haley et al. (2025) dataset, which may cite it.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000143 "PATO:0000008")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000143 "STATO:0000150")
AnnotationAssertion(rdfs:label obo:EMPTY_0000143 "obsolete C. elegans behavioral assay: minimum velocity during encounter"@en)
AnnotationAssertion(owl:deprecated obo:EMPTY_0000143 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000144 (C. elegans behavioral assay: peak velocity before encounter onset)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000144 "The peak instantaneous velocity of the C. elegans worm observed within 10 seconds before its entry into a bacterial food patch. Unit: µm/s.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000144 "Obsolete: a summary statistic over a window of a general quantity is stated as that quantity with the statistic as the statement's method and the window as a condition, not as a term of its own. Use speed (PATO:0000008) with the method peak speed before an event (EMPTY:0000272) and the conditions analysis window start -10 s (EMPTY:0000281) and end 0 s (EMPTY:0000282) from the encounter onset. The value is not the maximum over the window. Kept for the v1 Haley et al. (2025) dataset, which may cite it.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000144 "PATO:0000008")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000144 "EMPTY:0000272")
AnnotationAssertion(rdfs:label obo:EMPTY_0000144 "obsolete C. elegans behavioral assay: peak velocity before encounter onset"@en)
AnnotationAssertion(owl:deprecated obo:EMPTY_0000144 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000145 (C. elegans behavioral assay: minimum velocity after encounter onset)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000145 "The minimum instantaneous velocity of the C. elegans worm observed within 10 seconds after its entry into a bacterial food patch. Unit: µm/s.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000145 "Obsolete: a summary statistic over a window of a general quantity is stated as that quantity with the statistic as the statement's method and the window as a condition, not as a term of its own. Use speed (PATO:0000008) with the method minimum speed after an event (EMPTY:0000273) and the conditions analysis window start 0 s (EMPTY:0000281) and end +10 s (EMPTY:0000282) from the encounter onset. The value is bounded below by the minimum during the encounter, so it is not the plain minimum over the window. Kept for the v1 Haley et al. (2025) dataset, which may cite it.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000145 "PATO:0000008")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000145 "EMPTY:0000273")
AnnotationAssertion(rdfs:label obo:EMPTY_0000145 "obsolete C. elegans behavioral assay: minimum velocity after encounter onset"@en)
AnnotationAssertion(owl:deprecated obo:EMPTY_0000145 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000146 (C. elegans behavioral assay: posterior probability of exploitation)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000146 "The posterior probability, derived from a Gaussian Mixture Model (GMM) Classification, that a given patch encounter represents an 'exploitation' event (i.e., the worm has accepted the patch and is consuming bacteria). This value ranges from 0 to 1. [Source: https://doi.org/10.7554/eLife.103191.2.sa4]")
AnnotationAssertion(rdfs:label obo:EMPTY_0000146 "obsolete C. elegans behavioral assay: posterior probability of exploitation"@en)
AnnotationAssertion(rdfs:comment obo:EMPTY_0000146 "Obsolete: a summary of a general quantity is stated as that quantity, with its statistic as the method and what it is about as conditions (T16 of the NDI V_eta tenets). Use posterior probability (STATO:0000703) keyed by behavioral state (EMPTY:0000289) = exploitation (EMPTY:0000290). Kept for the v1 Haley et al. (2025) dataset, which may cite it.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000146 "STATO:0000703")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000146 "EMPTY:0000290")
AnnotationAssertion(owl:deprecated obo:EMPTY_0000146 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000147 (C. elegans behavioral assay: posterior probability of sensing)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000147 "The posterior probability, derived from a semi-supervised Quadratic Discriminant Analysis (QDA), that a given patch encounter was 'sensed' by the C. elegans worm (i.e., the animal detected the presence of bacteria, typically indicated by a slowdown). This value ranges from 0 to 1. [Source: https://doi.org/10.7554/eLife.103191.2.sa4]")
AnnotationAssertion(rdfs:label obo:EMPTY_0000147 "obsolete C. elegans behavioral assay: posterior probability of sensing"@en)
AnnotationAssertion(rdfs:comment obo:EMPTY_0000147 "Obsolete: a summary of a general quantity is stated as that quantity, with its statistic as the method and what it is about as conditions (T16 of the NDI V_eta tenets). Use posterior probability (STATO:0000703) keyed by behavioral state (EMPTY:0000289) = sensing (EMPTY:0000291). Kept for the v1 Haley et al. (2025) dataset, which may cite it.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000147 "STATO:0000703")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000147 "EMPTY:0000291")
AnnotationAssertion(owl:deprecated obo:EMPTY_0000147 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000148 (C. elegans behavioral assay: relative density of encountered bacteria)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000148 "A normalized, quantitative measure of the bacterial density of a specific bacterial food patch that a C. elegans worm encounters during an assay. [Source: https://doi.org/10.7554/eLife.103191.2.sa4]")
AnnotationAssertion(rdfs:label obo:EMPTY_0000148 "obsolete C. elegans behavioral assay: relative density of encountered bacteria"@en)
AnnotationAssertion(rdfs:comment obo:EMPTY_0000148 "Obsolete: replaced in the NDI V2 Haley import by relative cell density (EMPTY:0000322), stated on an assay-plate patch at each encounter; this term named one use of the quantity rather than the quantity. Kept for the v1 Haley et al. (2025) dataset, which may cite it.")
