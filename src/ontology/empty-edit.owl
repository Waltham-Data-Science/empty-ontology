AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000074 "The specific anatomical region where tetanic light stimulation (TLS) is applied in optogenetic experiments to evoke neuronal activity. The value should be defined by the ONTOLOGY_NAME:ONTOLOGY_NODE (e.g. 'UBERON:0000123').")
AnnotationAssertion(rdfs:label obo:EMPTY_0000074 "optogenetic tetanus stimulation target location"@en)
