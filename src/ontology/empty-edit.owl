AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000131 "A binary image mask (logical matrix) representing the union of all individually detected bacterial patch areas on an assay plate. This mask defines all food-containing regions.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000131 "obsolete bacterial patch mask"@en)
AnnotationAssertion(rdfs:comment obo:EMPTY_0000131 "Obsolete 2026-10-20 (tenet T19): a mask is NCIT:C201530 Binary Mask with the condition Imaging Region of Interest (NCIT:C85402) = bacterial patch (EMPTY:0000325). Kept for the v1 Haley et al. (2025) dataset, which may cite it.")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000131 "NCIT:C201530")
AnnotationAssertion(owl:deprecated obo:EMPTY_0000131 "true"^^xsd:boolean)

