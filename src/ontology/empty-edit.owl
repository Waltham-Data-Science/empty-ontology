AnnotationAssertion(rdfs:comment obo:EMPTY_0000276 "The value of 'reference point' (NCIT:C45793) for distanceLawnEdge in analyzeWormLabTracks and analyzeEncounters (Haley et al. 2024).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000276 "nearest bacterial patch edge"@en)
SubClassOf(obo:EMPTY_0000276 obo:EMPTY_0000283)

# Class: obo:EMPTY_0000277 (encounter period)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000277 "The period of a subject's record a value is computed over, relative to its encounters: before its first encounter, during an encounter, or after an encounter.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000277 "encounter period"@en)
SubClassOf(obo:EMPTY_0000277 obo:NCIT_C25616)
SubClassOf(obo:EMPTY_0000277 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000278 (before the first encounter)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000278 "The period from the start of a subject's record to the start of its first encounter.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000278 "before the first encounter"@en)
SubClassOf(obo:EMPTY_0000278 obo:EMPTY_0000277)

# Class: obo:EMPTY_0000279 (during the encounter)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000279 "The period from the start to the end of an encounter, including any frames in which the subject is partly out of contact.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000279 "during the encounter"@en)
SubClassOf(obo:EMPTY_0000279 obo:EMPTY_0000277)

# Class: obo:EMPTY_0000280 (after the encounter)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000280 "The period from the end of an encounter to the start of the subject's next one, or to the end of its record.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000280 "after the encounter"@en)
SubClassOf(obo:EMPTY_0000280 obo:EMPTY_0000277)

# Class: obo:EMPTY_0000281 (analysis window start)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000281 "The start of the stretch of a time series a value was computed from, as a signed time from a reference time point (NCIT:C82576) given with it: negative before the reference, positive after.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000281 "analysis window start"@en)
SubClassOf(obo:EMPTY_0000281 obo:EMPTY_0000091)

# Class: obo:EMPTY_0000282 (analysis window end)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000282 "The end of the stretch of a time series a value was computed from, as a signed time from a reference time point (NCIT:C82576) given with it: negative before the reference, positive after.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000282 "analysis window end"@en)
SubClassOf(obo:EMPTY_0000282 obo:EMPTY_0000091)

# Class: obo:EMPTY_0000283 (bacterial patch edge)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000283 "The boundary of a bacterial patch on an agar plate: where its bacteria end.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000283 "bacterial patch edge"@en)
SubClassOf(obo:EMPTY_0000283 obo:NCIT_C45793)

# Class: obo:EMPTY_0000284 (bacterial patch center)

