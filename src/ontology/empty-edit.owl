AnnotationAssertion(rdfs:label obo:EMPTY_0000270 "potassium phosphate dibasic solution"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:EMPTY_0000270 "dipotassium hydrogen phosphate solution"@en)
