AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000341 "The smallest posterior probability of exploitation at which an encounter is classed a patch exploitation encounter.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000341 "patch exploitation encounter: minimum probability of exploitation"@en)
SubClassOf(obo:EMPTY_0000341 obo:STATO_0000633)

# Class: obo:EMPTY_0000342 (patch sampling encounter: minimum probability of sensing)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000342 "The smallest posterior probability of sensing at which an encounter is classed a patch sampling encounter.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000342 "patch sampling encounter: minimum probability of sensing"@en)
SubClassOf(obo:EMPTY_0000342 obo:STATO_0000633)

