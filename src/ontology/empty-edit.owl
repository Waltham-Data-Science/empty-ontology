AnnotationAssertion(rdfs:comment obo:EMPTY_0000285 "xPeak / yPeak in analyzeLawnProfiles (Haley et al. 2024).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000285 "bacterial patch fluorescence peak"@en)
SubClassOf(obo:EMPTY_0000285 obo:NCIT_C45793)

# Class: obo:EMPTY_0000286 (distance end point)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000286 "The point to which a distance is measured, paired with the reference point (NCIT:C45793) it is measured from.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000286 "distance end point"@en)
SubClassOf(obo:EMPTY_0000286 obo:NCIT_C45793)

# Class: obo:EMPTY_0000287 (normalization to background illumination)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000287 "A data transformation that corrects an image for uneven illumination by dividing it by an image of the light source alone (an empty plate) and scaling by that image's maximum.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000287 "As analyzeLawnProfiles and getFluorescenceBackground (Haley et al. 2024): the background image has outliers replaced against a moving median and is smoothed before the division; the window sizes are parameters of each use.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000287 "normalization to background illumination"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:EMPTY_0000287 "flat-field correction"@en)
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:EMPTY_0000287 "shading correction"@en)
SubClassOf(obo:EMPTY_0000287 obo:OBI_0200000)

# Class: obo:EMPTY_0000288 (circularity)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000288 "How close a two-dimensional shape is to a circle: 4 pi times its area divided by the square of its perimeter, 1 for a circle and smaller for any other shape.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000288 "The MATLAB regionprops 'Circularity' measure, as used for bacterial patches by Haley et al. 2024.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000288 "circularity"@en)
SubClassOf(obo:EMPTY_0000288 obo:PATO_0000052)

# Class: obo:EMPTY_0000289 (behavioral state)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000289 "A state of an animal's behavior, such as exploiting a food source or sensing it, of which a classifier may give the probability.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000289 "behavioral state"@en)
SubClassOf(obo:EMPTY_0000289 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000290 (exploitation)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000290 "The behavioral state of staying on and feeding from a food source, as against exploring away from it.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000290 "The exploit cluster of the two-cluster Gaussian mixture model over log(time on patch) and log(speed on patch) in labelEncounters (Haley et al. 2024).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000290 "exploitation"@en)
SubClassOf(obo:EMPTY_0000290 obo:EMPTY_0000289)

# Class: obo:EMPTY_0000291 (sensing)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000291 "The behavioral state of detecting a food source on reaching it, shown by slowing down on contact.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000291 "Classified by semi-supervised quadratic discriminant analysis of minimum speed, deceleration and maximum change in speed on entry, in labelEncounters (Haley et al. 2024).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000291 "sensing"@en)
SubClassOf(obo:EMPTY_0000291 obo:EMPTY_0000289)

# Class: obo:EMPTY_0000292 (encounter type)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000292 "The kind of patch encounter an animal made, assigned from the probabilities of its behavioral states.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000292 "encounter type"@en)
SubClassOf(obo:EMPTY_0000292 obo:EMPTY_0000115)

# Class: obo:EMPTY_0000293 (patch exploitation encounter)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000293 "A patch encounter in which the animal stays on the food and feeds from it.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000293 "In labelEncounters (Haley et al. 2024), assigned by a threshold on the posterior probability of exploitation; the threshold is a parameter of the classification. Relabelled 2026-10-20 from 'exploit' (tenet T19: a behavioural category, not the lab's rule).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000293 "patch exploitation encounter"@en)
SubClassOf(obo:EMPTY_0000293 obo:EMPTY_0000292)

# Class: obo:EMPTY_0000294 (patch sampling encounter)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000294 "A patch encounter in which the animal senses the food but does not stay to feed.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000294 "In labelEncounters (Haley et al. 2024), assigned by thresholds on the posterior probabilities of sensing and exploitation; the thresholds are parameters of the classification. Relabelled 2026-10-20 from 'sample' (tenet T19).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000294 "patch sampling encounter"@en)
SubClassOf(obo:EMPTY_0000294 obo:EMPTY_0000292)

# Class: obo:EMPTY_0000295 (on-patch search encounter)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000295 "A patch encounter in which the animal crosses onto the patch but neither senses the food nor stays to feed.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000295 "In labelEncounters (Haley et al. 2024), assigned by thresholds on the posterior probabilities of sensing and exploitation; the thresholds are parameters of the classification. Relabelled 2026-10-20 from 'search on patch' (tenet T19).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000295 "on-patch search encounter"@en)
SubClassOf(obo:EMPTY_0000295 obo:EMPTY_0000292)

# Class: obo:EMPTY_0000296 (off-patch search encounter)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000296 "A patch encounter in which the animal comes near the patch without crossing onto it, and neither senses the food nor stays to feed.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000296 "In labelEncounters (Haley et al. 2024), assigned by thresholds on the posterior probabilities of sensing and exploitation and on how far the animal's midpoint reached into the patch (distanceOnMax < 0); the thresholds are parameters of the classification. Relabelled 2026-10-20 from 'search off patch' (tenet T19).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000296 "off-patch search encounter"@en)
SubClassOf(obo:EMPTY_0000296 obo:EMPTY_0000292)

# Class: obo:EMPTY_0000297 (nearest bacterial patch)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000297 "The bacterial patch closest to a point: to a pixel of a plate image, or to an animal at one moment of its track.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000297 "closestLawnID in analyzeWormLabTracks and the closest-patch maps of analyzeGFP (Haley et al. 2024). Whether the value is per pixel or per video frame is said by the statement's keys, not by this term.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000297 "nearest bacterial patch"@en)
SubClassOf(obo:EMPTY_0000297 obo:EMPTY_0000123)

# Class: obo:EMPTY_0000298 (value basis)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000298 "What a stated value rests on: whether it is a target set in advance, or (as other values may be) a measurement or an estimate. Stated as a condition only where a value is not a measurement.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000298 "value basis"@en)
SubClassOf(obo:EMPTY_0000298 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000299 (target)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000299 "A value set in advance as what something is meant to be, rather than one measured from it: a template's patch diameter, or the planned spacing between patches.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000299 "target"@en)
SubClassOf(obo:EMPTY_0000299 obo:EMPTY_0000298)

# Class: obo:EMPTY_0000300 (brightfield imaging)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000300 "An imaging assay in which a specimen is lit from behind and recorded against a bright background, with a camera and lens rather than a microscope, as in the video recording of animals on a backlit plate.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000300 "The behavior rigs of Haley et al. 2024: a camera and lens over a backlight.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000300 "brightfield imaging"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:EMPTY_0000300 "bright-field imaging"@en)
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:EMPTY_0000300 "brightfield microscopy"@en)
SubClassOf(obo:EMPTY_0000300 obo:OBI_0000185)

# Class: obo:EMPTY_0000301 (video tracking)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000301 "A data transformation that follows an animal, or points on its body, through the frames of a video, giving its position in each frame.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000301 "WormLab tracking in Haley et al. 2024; the software is stated on the statement, not in this term.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000301 "video tracking"@en)
SubClassOf(obo:EMPTY_0000301 obo:OBI_0200000)

# Class: obo:EMPTY_0000302 (distance transform)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000302 "A data transformation that gives, for each point of an image, its distance to the nearest edge of a region in a binary mask, signed by whether the point is inside or outside the region.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000302 "The distance of an animal to the nearest bacterial patch edge in analyzeWormLabTracks (Haley et al. 2024).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000302 "distance transform"@en)
SubClassOf(obo:EMPTY_0000302 obo:OBI_0200000)

# Class: obo:EMPTY_0000303 (encounter detection)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000303 "A data transformation that finds the periods in which a subject is in contact with another entity, from its position relative to that entity over time.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000303 "analyzeEncounters (Haley et al. 2024): body-part entries into and exits from a patch, merged into encounters by distance thresholds. What was encountered is the method parameter encountered entity (EMPTY:0000328). Generalised 2026-10-20 (tenet T19) from 'patch encounter detection'.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000303 "encounter detection"@en)
SubClassOf(obo:EMPTY_0000303 obo:OBI_0200000)

# Class: obo:EMPTY_0000304 (prediction from a fitted model)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000304 "A data transformation that computes a value by evaluating a fitted model at given values of its independent variables.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000304 "The estimated border amplitude of a patch from the E. coli growth fits, in labelEncounters (Haley et al. 2024).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000304 "prediction from a fitted model"@en)
SubClassOf(obo:EMPTY_0000304 obo:OBI_0200000)

# Class: obo:EMPTY_0000305 (interpolation method)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000305 "A setting of a data transformation: how values missing between known points are filled in.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000305 "interpolation method"@en)
SubClassOf(obo:EMPTY_0000305 obo:EMPTY_0000080)

# Class: obo:EMPTY_0000306 (linear interpolation)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000306 "A data transformation that fills a value between two known points on the straight line joining them.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000306 "linear interpolation"@en)
SubClassOf(obo:EMPTY_0000306 obo:OBI_0200000)

# Class: obo:EMPTY_0000307 (maximum gap filled)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000307 "A setting of a data transformation that fills gaps in a series: the longest gap it fills; longer gaps are left missing.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000307 "maximum gap filled"@en)
SubClassOf(obo:EMPTY_0000307 obo:EMPTY_0000080)

# Class: obo:EMPTY_0000308 (bin width)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000308 "A setting of a data transformation that groups values by a variable: the width of each group along that variable.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000308 "bin width"@en)
SubClassOf(obo:EMPTY_0000308 obo:EMPTY_0000080)

# Class: obo:EMPTY_0000309 (video frame)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000309 "The position of a frame in a video, counted from the first frame as 0: a coordinate along a video's frames.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000309 "Used as the key of per-frame tracks; the source's 1-based frame numbers are kept as the key's source origin.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000309 "video frame"@en)
SubClassOf(obo:EMPTY_0000309 obo:NCIT_C44465)

# Class: obo:EMPTY_0000310 (image upper-left corner)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000310 "The upper-left corner of an image as it is stored and displayed: the origin of pixel coordinates that count columns to the right and rows downward.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000310 "image upper-left corner"@en)
SubClassOf(obo:EMPTY_0000310 obo:NCIT_C45793)

# Class: obo:EMPTY_0000311 (image right)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000311 "The direction along an image's rows from its left edge toward its right edge, in which the column number increases.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000311 "image right"@en)
SubClassOf(obo:EMPTY_0000311 obo:NCIT_C42677)

# Class: obo:EMPTY_0000312 (image down)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000312 "The direction along an image's columns from its top edge toward its bottom edge, in which the row number increases.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000312 "image down"@en)
SubClassOf(obo:EMPTY_0000312 obo:NCIT_C42677)

# Class: obo:EMPTY_0000313 (dipotassium hydrogen phosphate trihydrate)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000313 "The trihydrate of dipotassium hydrogen phosphate, K2HPO4.3H2O (molar mass 228.22 g/mol), the form weighed out for some buffers: a given mass of it holds less phosphate than the same mass of the anhydrous salt.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000313 "ChEBI has the anhydrous salt (CHEBI:131527) but no trihydrate (OLS search, 2026-10-19). Sigma P5504 in the Haley et al. 2024 recipes.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:EMPTY_0000313 "K2HPO4 trihydrate"@en)
AnnotationAssertion(rdfs:label obo:EMPTY_0000313 "dipotassium hydrogen phosphate trihydrate"@en)
SubClassOf(obo:EMPTY_0000313 obo:CHEBI_131527)

# Class: obo:EMPTY_0000314 (inclusion in analysis)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000314 "Whether a subject, or the data recorded from it, was included in a study's analysis. A yes/no property: stated as false where a subject was excluded, and not stated for the subjects that were included.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000314 "The reason for an exclusion goes in the statement's notes. Replaces the v1 'data exclusion flag' (EMPTY:0000069) for the NDI V2 Haley import.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000314 "inclusion in analysis"@en)
SubClassOf(obo:EMPTY_0000314 obo:EMPTY_0000085)

# Class: obo:EMPTY_0000315 (directory of files)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000315 "A data format that is a folder of files rather than a single file, with no layout of its contents specified by this term; the program that wrote it, or the record that holds it, says how to read it.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000315 "The format of a spike sorter's output folder (Kilosort, Kiasort, JRCLUST) in NDI V_eta. EDAM has no format for a folder or for any sorter's output (OLS search: kilosort, phy format, directory, folder).")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:EMPTY_0000315 "folder"@en)
AnnotationAssertion(rdfs:label obo:EMPTY_0000315 "directory of files"@en)
SubClassOf(obo:EMPTY_0000315 obo:format_1915)

# Class: obo:EMPTY_0000316 (Gaussian mixture model clustering)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000316 "A class discovery data transformation that fits a mixture of Gaussian distributions to the data and assigns each data point the posterior probability of belonging to each component.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000316 "The method of the posterior probability of exploitation in the Haley et al. (2025) C. elegans foraging dataset: a two-component model of log encounter duration and log average on-patch speed (labelEncounters, fitgmdist). OBI has k-means and hierarchical clustering but no Gaussian mixture model (OLS search, 2026-10-20).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:EMPTY_0000316 "GMM clustering"@en)
AnnotationAssertion(rdfs:label obo:EMPTY_0000316 "Gaussian mixture model clustering"@en)
SubClassOf(obo:EMPTY_0000316 obo:OBI_0200171)
SubClassOf(obo:EMPTY_0000316 obo:OBI_0200175)

# Class: obo:EMPTY_0000317 (quadratic discriminant analysis)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000317 "A discriminant analysis that models each class as a Gaussian distribution with its own covariance, so that the boundary between classes is a quadratic surface.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000317 "The method of the posterior probability of sensing in the Haley et al. (2025) C. elegans foraging dataset (labelEncounters, fitcdiscr with DiscrimType quadratic, semi-supervised). OBI has discriminant analysis (OBI:0200106) but not its quadratic form (OLS search, 2026-10-20).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:EMPTY_0000317 "QDA"@en)
AnnotationAssertion(rdfs:label obo:EMPTY_0000317 "quadratic discriminant analysis"@en)
SubClassOf(obo:EMPTY_0000317 obo:OBI_0200106)

# Class: obo:EMPTY_0000318 (obsolete reference mark mask)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000318 "A binary image (logical matrix) in which the pixels of a reference mark drawn or placed on an assay plate are marked (true) and all other pixels are unmarked (false).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000318 "obsolete reference mark mask"@en)
AnnotationAssertion(rdfs:comment obo:EMPTY_0000318 "Obsolete 2026-10-20 before release (tenet T19): a mask is NCIT:C201530 Binary Mask with the condition Imaging Region of Interest (NCIT:C85402) = reference mark (EMPTY:0000327).")
AnnotationAssertion(oboInOwl:consider obo:EMPTY_0000318 "NCIT:C201530")
AnnotationAssertion(owl:deprecated obo:EMPTY_0000318 "true"^^xsd:boolean)

# Class: obo:EMPTY_0000319 (acclimation plate)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000319 "A Petri dish of seeded agar on which animals are kept for a set time before an assay so that they adapt to its conditions.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000319 "A location a C. elegans cohort is moved to in the Haley et al. (2025) dataset.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000319 "acclimation plate"@en)
SubClassOf(obo:EMPTY_0000319 obo:NCIT_C96141)

# Class: obo:EMPTY_0000320 (food deprivation plate)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000320 "A Petri dish of agar with no bacterial food, on which animals are kept for a set time to deprive them of food before an assay.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000320 "A location a C. elegans cohort is moved to in the Haley et al. (2025) dataset.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000320 "food deprivation plate"@en)
SubClassOf(obo:EMPTY_0000320 obo:NCIT_C96141)

# Class: obo:EMPTY_0000321 (assay plate)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000321 "A Petri dish of agar, prepared with the arena and bacterial patches of an assay, on which animals are recorded during that assay.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000321 "A location a C. elegans cohort is moved to in the Haley et al. (2025) dataset.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000321 "assay plate"@en)
SubClassOf(obo:EMPTY_0000321 obo:NCIT_C96141)

# Class: obo:EMPTY_0000322 (relative cell density)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000322 "The density of cells in a sample relative to reference samples of known density: the sample's measured signal divided by the mean signal of the reference samples, times their density. Stated in the reference samples' units, such as OD600 equivalents.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000322 "In the Haley et al. (2025) C. elegans foraging dataset, the relative density of a bacterial patch in OD600 equivalents (modelExploit, fig3_single): 10 x a patch's fluorescence border amplitude / the mean over the foragingConcentration OD600 10, 0.5 uL patches, floored at 0.01 for a patch of LB alone; the model uses its log10. Replaces the obsolete EMPTY:0000148 and EMPTY:0000149, which named the two uses (encountered and cultivation bacteria) rather than the quantity.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000322 "relative cell density"@en)
SubClassOf(obo:EMPTY_0000322 obo:NCIT_C120538)

# Class: obo:EMPTY_0000323 (normalization reference value)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000323 "A parameter of a normalization: the value of a reference condition that each value is divided by.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000323 "normalization reference value"@en)
SubClassOf(obo:EMPTY_0000323 obo:EMPTY_0000080)

# Class: obo:EMPTY_0000324 (lower limit of reported value)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000324 "A parameter of a calculation: the smallest value it reports; a smaller result, including zero, is reported as this value.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000324 "Used where a value is later log-transformed, so that zero has a finite logarithm (Haley et al. 2025: a patch of LB alone is given relative density 0.01).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000324 "lower limit of reported value"@en)
SubClassOf(obo:EMPTY_0000324 obo:EMPTY_0000080)

# Class: obo:EMPTY_0000325 (bacterial patch)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000325 "A discrete area of bacteria grown on a solid medium from a pipetted suspension.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000325 "An entity's kind, asserted on each patch, and the value of conditions such as Imaging Region of Interest and encountered entity (Haley et al. 2025: the OP50 and OP50-GFP patches; a spot of LB alone is a patch with no bacteria).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000325 "bacterial patch"@en)
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:EMPTY_0000325 "bacterial lawn"@en)
SubClassOf(obo:EMPTY_0000325 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000326 (arena)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000326 "The bounded region in which an experiment's subjects are confined and observed.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000326 "arena"@en)
SubClassOf(obo:EMPTY_0000326 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000327 (reference mark)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000327 "A mark drawn or placed on a plate or arena to register its images to a common frame.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000327 "reference mark"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:EMPTY_0000327 "fiducial marker"@en)
SubClassOf(obo:EMPTY_0000327 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000328 (encountered entity)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000328 "A parameter of an encounter detection method: the kind of entity whose encounters it finds.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000328 "encountered entity"@en)
SubClassOf(obo:EMPTY_0000328 obo:EMPTY_0000080)

# Class: obo:EMPTY_0000329 (potassium phosphate buffer)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000329 "A buffer solution of potassium dihydrogen phosphate and dipotassium hydrogen phosphate.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000329 "No ontology term found (2026-10-20): NCIT Phosphate Buffer and PBS are broader or contain sodium chloride. The composition is recorded as the formulation's ingredients.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000329 "potassium phosphate buffer"@en)
SubClassOf(obo:EMPTY_0000329 obo:NCIT_C70815)

# Class: obo:EMPTY_0000330 (potassium citrate solution)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000330 "A solution of citric acid and tripotassium citrate, buffered to a stated pH.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000330 "No ontology term found (2026-10-20): NCIT Buffer is broader. The composition is recorded as the formulation's ingredients.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000330 "potassium citrate solution"@en)
SubClassOf(obo:EMPTY_0000330 obo:NCIT_C70815)

# Class: obo:EMPTY_0000331 (seeding)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000331 "Adding a bacterial suspension onto a solid culture medium so that it grows into a patch.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000331 "NCIT Inoculation (C68774) is broader: it also covers introducing sera and vaccines.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000331 "seeding"@en)
SubClassOf(obo:EMPTY_0000331 obo:OBI_0000274)

# Class: obo:EMPTY_0000332 (pouring)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000332 "Making an agar plate by pouring molten medium into a dish and letting it set.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000332 "pouring"@en)
SubClassOf(obo:EMPTY_0000332 obo:COB_0000110)

# Class: obo:EMPTY_0000333 (incubation)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000333 "Holding a material in an incubator at a set temperature, typically so that organisms in it grow.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000333 "NCIT Incubated (C15685) is an undefined qualifier, not a procedure.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000333 "incubation"@en)
SubClassOf(obo:EMPTY_0000333 obo:OBI_0000838)

# Class: obo:EMPTY_0000334 (refrigeration)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000334 "Holding a material in a refrigerator or cold room, above freezing and below ambient temperature.")
AnnotationAssertion(rdfs:comment obo:EMPTY_0000334 "NCIT Refrigerate (C202341) is the act of cooling an item, not holding it cold.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000334 "refrigeration"@en)
SubClassOf(obo:EMPTY_0000334 obo:OBI_0302893)

# Class: obo:EMPTY_0000335 (ambient exposure)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000335 "Holding a material at the room's ambient temperature and humidity.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000335 "ambient exposure"@en)
SubClassOf(obo:EMPTY_0000335 obo:OBI_0000838)

# Class: obo:EMPTY_0000336 (agar plug transfer)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000336 "Moving organisms from one culture plate to another on a piece of agar cut from the first.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000336 "agar plug transfer"@en)
SubClassOf(obo:EMPTY_0000336 obo:COB_0000035)

# Class: obo:EMPTY_0000337 (worm picking)

AnnotationAssertion(obo:IAO_0000115 obo:EMPTY_0000337 "Moving animals one at a time from one plate to another with a wire pick.")
AnnotationAssertion(rdfs:label obo:EMPTY_0000337 "worm picking"@en)
SubClassOf(obo:EMPTY_0000337 obo:COB_0000035)

