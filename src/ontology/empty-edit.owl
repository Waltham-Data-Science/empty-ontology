AnnotationAssertion(rdfs:comment obo:EMPTY_0000284 "In analyzeLawnProfiles (Haley et al. 2024), the patch's area left when its edge mask is shrunk by half (centerAmplitude).")
AnnotationAssertion(rdfs:label obo:EMPTY_0000284 "bacterial patch center"@en)
SubClassOf(obo:EMPTY_0000284 obo:EMPTY_0000076)

# Class: obo:EMPTY_0000285 (bacterial patch fluorescence peak)

