AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002486> "sends output to")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002486> <http://purl.obolibrary.org/obo/RO_0002170>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002487> (relation between physical entity and a process or stage)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002487> "relation between physical entity and a process or stage")
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/RO_0002487> <http://purl.obolibrary.org/obo/BFO_0000004>)
