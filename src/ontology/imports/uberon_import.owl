TransitiveObjectProperty(<http://purl.obolibrary.org/obo/RO_0002224>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002225> (develops from part of)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RO_0002225> "x develops from part of y if and only if there exists some z such that x develops from z and z is part of y")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002225> "develops from part of")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002225> "develops from part of"@en)
