AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RO_0002226> "x develops_in y if x is located in y whilst x is developing")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002226> "develops in")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002226> "develops in"@en)
