AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBI_0200171> "A partitioning data transformation is a data transformation that has objective partitioning."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBI_0200171> "partitioning data transformation"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/OBI_0200171> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000417> <http://purl.obolibrary.org/obo/OBI_0200172>))
