SubClassOf(<http://purl.obolibrary.org/obo/MCO_0000030> <http://purl.obolibrary.org/obo/MICRO_0000562>)

# Class: <http://purl.obolibrary.org/obo/MCO_0000059> (OD600)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MCO_0000059> "an optical density that specifies the amount of light of 600 nm of wavelenght the bearer is able to transmit")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MCO_0000059> "OD600"@en)
SubClassOf(<http://purl.obolibrary.org/obo/MCO_0000059> <http://purl.obolibrary.org/obo/MCO_0000077>)

# Class: <http://purl.obolibrary.org/obo/MCO_0000077> (optical density)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MCO_0000077> "A physical quality that inheres in a bearer by virtue of the amount of light that the bearer of the quality is able to transmit")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MCO_0000077> "optical density"@en)
SubClassOf(<http://purl.obolibrary.org/obo/MCO_0000077> <http://purl.obolibrary.org/obo/PATO_0001300>)

# Class: <http://purl.obolibrary.org/obo/MCO_0000894> (biological entity)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MCO_0000894> "A biological entity is a heterogeneous substance that contains genomic material or is the product of a biological process.")
